<Project Sdk="Microsoft.NET.Sdk">

  <!-- Project properties -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
      
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
      
    <RootNamespace>CaptureTool.Presentation.Windows.WinUI</RootNamespace>
    <AssemblyName>CaptureTool.Presentation.Windows.WinUI</AssemblyName>
      
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
      
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxAddDefaultTargetDeviceFamilyItem>false</AppxAddDefaultTargetDeviceFamilyItem>
    <AppxOSMinVersionReplaceManifestVersion>false</AppxOSMinVersionReplaceManifestVersion>
    <AppxOSMaxVersionTestedReplaceManifestVersion>false</AppxOSMaxVersionTestedReplaceManifestVersion>
  </PropertyGroup>

  <!-- App manifest -->
  <ItemGroup>
    <Content Include="..\CaptureTool.Infrastructure.Analysis.Windows\CaptureAnalysisProviders.json"
             Link="CaptureAnalysisProviders.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Package references -->
  <ItemGroup>
    <PackageReference Include="CaptureKit.Windows" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Project references -->
  <ItemGroup>
    <ProjectReference Include="..\CaptureTool.Application.Abstractions\CaptureTool.Application.Abstractions.csproj" GlobalPropertiesToRemove="WindowsAppSDKSelfContained;WindowsPackageType;EnableMsixTooling" />
    <ProjectReference Include="..\CaptureTool.Application\CaptureTool.Application.csproj" GlobalPropertiesToRemove="WindowsAppSDKSelfContained;WindowsPackageType;EnableMsixTooling" />
    <ProjectReference Include="..\CaptureTool.Infrastructure.Edit.Windows\CaptureTool.Infrastructure.Edit.Windows.csproj" GlobalPropertiesToRemove="WindowsAppSDKSelfContained;WindowsPackageType;EnableMsixTooling" />
    <ProjectReference Include="..\CaptureTool.Infrastructure.Analysis.Windows\CaptureTool.Infrastructure.Analysis.Windows.csproj" GlobalPropertiesToRemove="WindowsAppSDKSelfContained;WindowsPackageType;EnableMsixTooling" />
    <ProjectReference Include="..\CaptureTool.Domain\CaptureTool.Domain.csproj" GlobalPropertiesToRemove="WindowsAppSDKSelfContained;WindowsPackageType;EnableMsixTooling" />
    <ProjectReference Include="..\CaptureTool.Domain.Edit\CaptureTool.Domain.Edit.csproj" GlobalPropertiesToRemove="WindowsAppSDKSelfContained;WindowsPackageType;EnableMsixTooling" />
    <ProjectReference Include="..\CaptureTool.Infrastructure.Capture.Windows\CaptureTool.Infrastructure.Capture.Windows.csproj" GlobalPropertiesToRemove="WindowsAppSDKSelfContained;WindowsPackageType;EnableMsixTooling" />
    <ProjectReference Include="..\CaptureTool.Domain.Capture\CaptureTool.Domain.Capture.csproj" GlobalPropertiesToRemove="WindowsAppSDKSelfContained;WindowsPackageType;EnableMsixTooling" />
    <ProjectReference Include="..\CaptureTool.FeatureManagement\CaptureTool.FeatureManagement.csproj" GlobalPropertiesToRemove="WindowsAppSDKSelfContained;WindowsPackageType;EnableMsixTooling" />
    <ProjectReference Include="..\CaptureTool.Infrastructure.Windows\CaptureTool.Infrastructure.Windows.csproj" GlobalPropertiesToRemove="WindowsAppSDKSelfContained;WindowsPackageType;EnableMsixTooling" />
    <ProjectReference Include="..\CaptureTool.Infrastructure\CaptureTool.Infrastructure.csproj" GlobalPropertiesToRemove="WindowsAppSDKSelfContained;WindowsPackageType;EnableMsixTooling" />
    <ProjectReference Include="..\CaptureTool.Presentation\CaptureTool.Presentation.csproj" GlobalPropertiesToRemove="WindowsAppSDKSelfContained;WindowsPackageType;EnableMsixTooling" />
  </ItemGroup>

  <!-- Content files -->
  <ItemGroup>
    <Content Include="Fonts\FluentSystemIcons-Regular.ttf" />
  </ItemGroup>

  <!-- Validate both package architectures without modifying Visual Studio's
       loose MSIX layout. The MSIX tooling must remain the sole owner of AppX;
       copying a self-contained test output into a framework-dependent layout
       mixes incompatible Windows App SDK runtime binaries. -->
  <Target Name="ValidateCaptureKitPackageAssets"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_CaptureToolCaptureKitRuntimeIdentifier Condition="'$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64')">win-x64</_CaptureToolCaptureKitRuntimeIdentifier>
      <_CaptureToolCaptureKitRuntimeIdentifier Condition="'$(RuntimeIdentifier)' == 'win-arm64' or ('$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64')">win-arm64</_CaptureToolCaptureKitRuntimeIdentifier>
      <_CaptureToolCaptureKitWindowsRoot>$(NuGetPackageRoot)capturekit.windows\$(CaptureKitPackageVersion)\</_CaptureToolCaptureKitWindowsRoot>
      <_CaptureToolCaptureKitAbstractionsRoot>$(NuGetPackageRoot)capturekit.abstractions\$(CaptureKitPackageVersion)\</_CaptureToolCaptureKitAbstractionsRoot>
    </PropertyGroup>

    <Error Condition="('$(RuntimeIdentifier)' == 'win-x64' and '$(Platform)' == 'ARM64') or ('$(RuntimeIdentifier)' == 'win-arm64' and '$(Platform)' == 'x64')"
           Text="RuntimeIdentifier $(RuntimeIdentifier) conflicts with Platform $(Platform)." />
    <Error Condition="'$(_CaptureToolCaptureKitRuntimeIdentifier)' == ''"
           Text="Could not determine the CaptureKit runtime identifier for $(Platform)/$(RuntimeIdentifier)." />

    <ItemGroup>
      <_CaptureToolCaptureKitAsset Include="$(_CaptureToolCaptureKitAbstractionsRoot)lib\net10.0\CaptureKit.Abstractions.dll" />
      <_CaptureToolCaptureKitAsset Include="$(_CaptureToolCaptureKitWindowsRoot)lib\net10.0-windows10.0.26100\CaptureKit.Windows.dll" />
      <_CaptureToolCaptureKitAsset Include="$(_CaptureToolCaptureKitWindowsRoot)runtimes\$(_CaptureToolCaptureKitRuntimeIdentifier)\native\CaptureKit.Windows.Native.Recording.dll" />
      <_CaptureToolCaptureKitAsset Include="$(_CaptureToolCaptureKitWindowsRoot)runtimes\$(_CaptureToolCaptureKitRuntimeIdentifier)\native\CaptureKit.Windows.Native.Screenshot.dll" />
      <_CaptureToolCaptureKitAsset Include="$(_CaptureToolCaptureKitWindowsRoot)runtimes\$(_CaptureToolCaptureKitRuntimeIdentifier)\native\CaptureKit.Windows.Native.Recording.pdb"
                                   Condition="Exists('$(_CaptureToolCaptureKitWindowsRoot)runtimes\$(_CaptureToolCaptureKitRuntimeIdentifier)\native\CaptureKit.Windows.Native.Recording.pdb')" />
      <_CaptureToolCaptureKitAsset Include="$(_CaptureToolCaptureKitWindowsRoot)runtimes\$(_CaptureToolCaptureKitRuntimeIdentifier)\native\CaptureKit.Windows.Native.Screenshot.pdb"
                                   Condition="Exists('$(_CaptureToolCaptureKitWindowsRoot)runtimes\$(_CaptureToolCaptureKitRuntimeIdentifier)\native\CaptureKit.Windows.Native.Screenshot.pdb')" />
    </ItemGroup>

    <Error Condition="!Exists('%(_CaptureToolCaptureKitAsset.Identity)')"
           Text="CaptureKit $(CaptureKitPackageVersion) is missing required asset %(_CaptureToolCaptureKitAsset.Identity)." />
  </Target>
    
  <!-- 
    Don't generate the XAML main function and use the one in Program.cs instead.
    https://learn.microsoft.com/en-us/windows/apps/windows-app-sdk/applifecycle/applifecycle-single-instance
  -->
  <PropertyGroup>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish profiles -->
  <ItemGroup>
    <Folder Include="Properties\PublishProfiles\" />
  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <AppxBundle>Auto</AppxBundle>
    <AppxBundlePlatforms>arm64|x64</AppxBundlePlatforms>
    <AppxPackageDir>$(SolutionDir)output\$(Platform)\</AppxPackageDir>
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxSymbolPackageEnabled>True</AppxSymbolPackageEnabled>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <PublishAot>true</PublishAot>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>

  <!-- Use the Native AOT PDB that matches the packaged app executable for Store symbol packages. -->
  <Target Name="UseNativeAotPdbForAppxSymbolPackage"
          AfterTargets="_CalculateInputsForGenerateAppxPackageRecipe"
          BeforeTargets="_GenerateAppxSymbolPackage"
          Condition="'$(PublishAot)' == 'true' and '$(AppxSymbolPackageEnabled)' == 'true'">
    <PropertyGroup>
      <_NativeAotAppPdbPath>$(OutDir)native\$(AssemblyName).pdb</_NativeAotAppPdbPath>
      <_CaptureKitRecordingNativePdbPath>$(OutDir)CaptureKit.Windows.Native.Recording.pdb</_CaptureKitRecordingNativePdbPath>
      <_CaptureKitScreenshotNativePdbPath>$(OutDir)CaptureKit.Windows.Native.Screenshot.pdb</_CaptureKitScreenshotNativePdbPath>
    </PropertyGroup>

    <ItemGroup>
      <PDBPayload Remove="@(PDBPayload)"
                  Condition="'%(Filename)%(Extension)' == '$(AssemblyName).pdb'" />
      <PDBPayload Remove="@(PDBPayload)"
                  Condition="'%(Filename)%(Extension)' == 'CaptureKit.Windows.Native.Recording.pdb'" />
      <PDBPayload Remove="@(PDBPayload)"
                  Condition="'%(Filename)%(Extension)' == 'CaptureKit.Windows.Native.Screenshot.pdb'" />
      <PDBPayload Include="$(_NativeAotAppPdbPath)">
        <TargetPath>$(AssemblyName).pdb</TargetPath>
      </PDBPayload>
      <PDBPayload Include="$(_CaptureKitRecordingNativePdbPath)"
                  Condition="Exists('$(_CaptureKitRecordingNativePdbPath)')">
        <TargetPath>CaptureKit.Windows.Native.Recording.pdb</TargetPath>
      </PDBPayload>
      <PDBPayload Include="$(_CaptureKitScreenshotNativePdbPath)"
                  Condition="Exists('$(_CaptureKitScreenshotNativePdbPath)')">
        <TargetPath>CaptureKit.Windows.Native.Screenshot.pdb</TargetPath>
      </PDBPayload>
    </ItemGroup>
  </Target>

  <Target Name="UseNativeAotPdbForAppxUploadSymbolPackage"
          AfterTargets="_CalculateInputsForGenerateAppxUploadPackageRecipe"
          BeforeTargets="_GenerateAppxUploadSymbolPackage"
          Condition="'$(PublishAot)' == 'true' and '$(AppxSymbolPackageEnabled)' == 'true'">
    <PropertyGroup>
      <_NativeAotAppPdbPath>$(OutDir)native\$(AssemblyName).pdb</_NativeAotAppPdbPath>
      <_CaptureKitRecordingNativePdbPath>$(OutDir)CaptureKit.Windows.Native.Recording.pdb</_CaptureKitRecordingNativePdbPath>
      <_CaptureKitScreenshotNativePdbPath>$(OutDir)CaptureKit.Windows.Native.Screenshot.pdb</_CaptureKitScreenshotNativePdbPath>
    </PropertyGroup>

    <ItemGroup>
      <PDBUploadPayload Remove="@(PDBUploadPayload)"
                        Condition="'%(Filename)%(Extension)' == '$(AssemblyName).pdb'" />
      <PDBUploadPayload Remove="@(PDBUploadPayload)"
                        Condition="'%(Filename)%(Extension)' == 'CaptureKit.Windows.Native.Recording.pdb'" />
      <PDBUploadPayload Remove="@(PDBUploadPayload)"
                        Condition="'%(Filename)%(Extension)' == 'CaptureKit.Windows.Native.Screenshot.pdb'" />
      <PDBUploadPayload Include="$(_NativeAotAppPdbPath)">
        <TargetPath>$(AssemblyName).pdb</TargetPath>
      </PDBUploadPayload>
      <PDBUploadPayload Include="$(_CaptureKitRecordingNativePdbPath)"
                        Condition="Exists('$(_CaptureKitRecordingNativePdbPath)')">
        <TargetPath>CaptureKit.Windows.Native.Recording.pdb</TargetPath>
      </PDBUploadPayload>
      <PDBUploadPayload Include="$(_CaptureKitScreenshotNativePdbPath)"
                        Condition="Exists('$(_CaptureKitScreenshotNativePdbPath)')">
        <TargetPath>CaptureKit.Windows.Native.Screenshot.pdb</TargetPath>
      </PDBUploadPayload>
    </ItemGroup>
  </Target>
</Project>
