<?xml version="1.0" encoding="utf-8" ?>
<local:UserControlBase
    x:Class="CaptureTool.Presentation.Windows.WinUI.Xaml.Controls.ImageDescriptionToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CaptureTool.Presentation.Windows.WinUI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ImageDescriptionToolbar}"
    mc:Ignorable="d">

    <Border
        Height="48"
        HorizontalAlignment="Center"
        Padding="8,6"
        Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource SystemControlBackgroundBaseLowBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Translation="0,0,16">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>

        <StackPanel Orientation="Horizontal" Spacing="4">
            <ToggleButton
                x:Uid="ImageDescriptionToolbar_BriefButton"
                MinHeight="34"
                AutomationProperties.AutomationId="ImageEdit_ImageDescriptionBriefButton"
                Click="ImageDescriptionButton_Click"
                Command="{x:Bind BriefCommand, Mode=OneWay}"
                IsChecked="{x:Bind IsBriefSelected, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Caption" />
                    <TextBlock
                        x:Uid="ImageDescriptionToolbar_BriefButtonText"
                        VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton
                x:Uid="ImageDescriptionToolbar_DetailedButton"
                MinHeight="34"
                AutomationProperties.AutomationId="ImageEdit_ImageDescriptionDetailedButton"
                Click="ImageDescriptionButton_Click"
                Command="{x:Bind DetailedCommand, Mode=OneWay}"
                IsChecked="{x:Bind IsDetailedSelected, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Document" />
                    <TextBlock
                        x:Uid="ImageDescriptionToolbar_DetailedButtonText"
                        VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton
                x:Uid="ImageDescriptionToolbar_DiagramButton"
                MinHeight="34"
                AutomationProperties.AutomationId="ImageEdit_ImageDescriptionDiagramButton"
                Click="ImageDescriptionButton_Click"
                Command="{x:Bind DiagramCommand, Mode=OneWay}"
                IsChecked="{x:Bind IsDiagramSelected, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Pictures" />
                    <TextBlock
                        x:Uid="ImageDescriptionToolbar_DiagramButtonText"
                        VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton
                x:Uid="ImageDescriptionToolbar_AccessibleButton"
                MinHeight="34"
                AutomationProperties.AutomationId="ImageEdit_ImageDescriptionAccessibleButton"
                Click="ImageDescriptionButton_Click"
                Command="{x:Bind AccessibleCommand, Mode=OneWay}"
                IsChecked="{x:Bind IsAccessibleSelected, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="FontIncrease" />
                    <TextBlock
                        x:Uid="ImageDescriptionToolbar_AccessibleButtonText"
                        VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
        </StackPanel>
    </Border>
</local:UserControlBase>
