<?xml version="1.0" encoding="utf-8" ?>
<local:UserControlBase
    x:Class="CaptureTool.Presentation.Windows.WinUI.Xaml.Controls.AiLoadingIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CaptureTool.Presentation.Windows.WinUI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.AccessibilityView="Control"
    AutomationProperties.LiveSetting="Polite"
    IsHitTestVisible="False"
    IsTabStop="False"
    mc:Ignorable="d">

    <Grid
        Width="72"
        Height="72">
        <Grid.Resources>
            <Storyboard x:Name="MagicMotionStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="OuterOrbitTransform"
                    Storyboard.TargetProperty="Angle"
                    Duration="0:0:3.2"
                    EnableDependentAnimation="True"
                    From="0"
                    RepeatBehavior="Forever"
                    To="360" />
                <DoubleAnimation
                    Storyboard.TargetName="InnerOrbitTransform"
                    Storyboard.TargetProperty="Angle"
                    Duration="0:0:4.4"
                    EnableDependentAnimation="True"
                    From="0"
                    RepeatBehavior="Forever"
                    To="-360" />
                <DoubleAnimation
                    Storyboard.TargetName="GlowHalo"
                    Storyboard.TargetProperty="Opacity"
                    AutoReverse="True"
                    Duration="0:0:1.2"
                    From="0.08"
                    RepeatBehavior="Forever"
                    To="0.24" />
                <DoubleAnimation
                    Storyboard.TargetName="GlowScaleTransform"
                    Storyboard.TargetProperty="ScaleX"
                    AutoReverse="True"
                    Duration="0:0:1.2"
                    EnableDependentAnimation="True"
                    From="0.82"
                    RepeatBehavior="Forever"
                    To="1.12" />
                <DoubleAnimation
                    Storyboard.TargetName="GlowScaleTransform"
                    Storyboard.TargetProperty="ScaleY"
                    AutoReverse="True"
                    Duration="0:0:1.2"
                    EnableDependentAnimation="True"
                    From="0.82"
                    RepeatBehavior="Forever"
                    To="1.12" />
                <DoubleAnimation
                    Storyboard.TargetName="CoreSparkle"
                    Storyboard.TargetProperty="Opacity"
                    AutoReverse="True"
                    Duration="0:0:0.9"
                    From="0.72"
                    RepeatBehavior="Forever"
                    To="1" />
                <DoubleAnimation
                    Storyboard.TargetName="CoreScaleTransform"
                    Storyboard.TargetProperty="ScaleX"
                    AutoReverse="True"
                    Duration="0:0:0.9"
                    EnableDependentAnimation="True"
                    From="0.88"
                    RepeatBehavior="Forever"
                    To="1.04" />
                <DoubleAnimation
                    Storyboard.TargetName="CoreScaleTransform"
                    Storyboard.TargetProperty="ScaleY"
                    AutoReverse="True"
                    Duration="0:0:0.9"
                    EnableDependentAnimation="True"
                    From="0.88"
                    RepeatBehavior="Forever"
                    To="1.04" />
                <DoubleAnimation
                    Storyboard.TargetName="OuterTwinkle"
                    Storyboard.TargetProperty="Opacity"
                    AutoReverse="True"
                    BeginTime="0:0:0.2"
                    Duration="0:0:0.7"
                    From="0.25"
                    RepeatBehavior="Forever"
                    To="1" />
                <DoubleAnimation
                    Storyboard.TargetName="InnerTwinkle"
                    Storyboard.TargetProperty="Opacity"
                    AutoReverse="True"
                    BeginTime="0:0:0.55"
                    Duration="0:0:0.8"
                    From="0.2"
                    RepeatBehavior="Forever"
                    To="0.9" />
            </Storyboard>
        </Grid.Resources>

        <Border
            Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="36"
            Opacity="0.94"
            Translation="0,0,12">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
        </Border>

        <Ellipse
            x:Name="GlowHalo"
            Width="48"
            Height="48"
            Fill="{ThemeResource AccentFillColorDefaultBrush}"
            Opacity="0.12"
            RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="GlowScaleTransform" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse
            Width="56"
            Height="56"
            Opacity="0.34"
            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
            StrokeDashArray="1,3"
            StrokeThickness="1.5" />

        <Canvas
            Width="60"
            Height="60"
            RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="OuterOrbitTransform" />
            </Canvas.RenderTransform>

            <Ellipse
                Width="6"
                Height="6"
                Canvas.Left="27"
                Canvas.Top="0"
                Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            <Ellipse
                Width="4"
                Height="4"
                Canvas.Left="4"
                Canvas.Top="40"
                Fill="{ThemeResource TextFillColorPrimaryBrush}"
                Opacity="0.7" />
            <Path
                x:Name="OuterTwinkle"
                Width="11"
                Height="11"
                Canvas.Left="45"
                Canvas.Top="42"
                Data="M 8,0 L 10,6 L 16,8 L 10,10 L 8,16 L 6,10 L 0,8 L 6,6 Z"
                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                Stretch="Fill" />
        </Canvas>

        <Canvas
            Width="42"
            Height="42"
            RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="InnerOrbitTransform" />
            </Canvas.RenderTransform>

            <Path
                x:Name="InnerTwinkle"
                Width="8"
                Height="8"
                Canvas.Left="17"
                Canvas.Top="0"
                Data="M 8,0 L 10,6 L 16,8 L 10,10 L 8,16 L 6,10 L 0,8 L 6,6 Z"
                Fill="{ThemeResource TextFillColorPrimaryBrush}"
                Stretch="Fill" />
            <Ellipse
                Width="4"
                Height="4"
                Canvas.Left="1"
                Canvas.Top="19"
                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                Opacity="0.8" />
        </Canvas>

        <Path
            x:Name="CoreSparkle"
            Width="26"
            Height="26"
            Data="M 12,0 C 13.7,6.3 17.7,10.3 24,12 C 17.7,13.7 13.7,17.7 12,24 C 10.3,17.7 6.3,13.7 0,12 C 6.3,10.3 10.3,6.3 12,0 Z"
            Fill="{ThemeResource AccentFillColorDefaultBrush}"
            RenderTransformOrigin="0.5,0.5"
            Stretch="Fill">
            <Path.RenderTransform>
                <ScaleTransform x:Name="CoreScaleTransform" />
            </Path.RenderTransform>
        </Path>
    </Grid>
</local:UserControlBase>
