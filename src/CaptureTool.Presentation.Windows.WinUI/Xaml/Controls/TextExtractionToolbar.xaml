<?xml version="1.0" encoding="utf-8" ?>
<local:UserControlBase
    x:Class="CaptureTool.Presentation.Windows.WinUI.Xaml.Controls.TextExtractionToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CaptureTool.Presentation.Windows.WinUI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:TextExtractionToolbar}"
    mc:Ignorable="d">

    <Border
        Padding="8,6"
        Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource SystemControlBackgroundBaseLowBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Translation="0,0,16">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>

        <Button
            x:Name="CopyAllTextButton"
            x:Uid="TextExtractionToolbar_CopyAllTextButton"
            MinHeight="34"
            AutomationProperties.AutomationId="ImageEdit_TextExtractionCopyAllButton"
            Command="{x:Bind CopyAllTextCommand, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Copy" />
                <TextBlock
                    x:Uid="TextExtractionToolbar_CopyAllTextButtonLabel"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Border>
</local:UserControlBase>
