<UserControl
    x:Class="CaptureTool.Presentation.Windows.WinUI.Xaml.Controls.CaptureAnalysisWelcome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="420" Spacing="18">
        <Border
            Height="126"
            BorderBrush="#806CAFFF"
            BorderThickness="1"
            CornerRadius="16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#161B44" />
                    <GradientStop Offset="0.55" Color="#554199" />
                    <GradientStop Offset="1" Color="#197779" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Ellipse
                    Width="124"
                    Height="124"
                    HorizontalAlignment="Right"
                    Opacity=".45">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#FFC7F4FF" />
                            <GradientStop Offset="1" Color="#00C7F4FF" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Path
                    Width="72"
                    Height="72"
                    Margin="0,0,32,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Data="M 36,0 C 40,23 49,32 72,36 C 49,40 40,49 36,72 C 32,49 23,40 0,36 C 23,32 32,23 36,0 Z"
                    Fill="#EEF6FF" />
                <Path
                    Width="24"
                    Height="24"
                    Margin="0,15,18,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Data="M 12,0 L 15,9 24,12 15,15 12,24 9,15 0,12 9,9 Z"
                    Fill="#A9E9F7" />
                <Path
                    Width="14"
                    Height="14"
                    Margin="0,0,118,17"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Data="M 7,0 L 9,5 14,7 9,9 7,14 5,9 0,7 5,5 Z"
                    Fill="#DECCFF" />
                <StackPanel
                    Margin="20"
                    Padding="0,0,125,0"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <TextBlock
                        x:Uid="CaptureWelcome_Eyebrow"
                        CharacterSpacing="100"
                        FontSize="11"
                        Foreground="#D8E2FF"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Uid="CaptureWelcome_Hero"
                        FontSize="23"
                        FontWeight="SemiBold"
                        Foreground="White"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    FontSize="20"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE8D2;" />
                <TextBlock
                    x:Uid="CaptureWelcome_Text"
                    Grid.Column="1"
                    TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    FontSize="20"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE720;" />
                <TextBlock
                    x:Uid="CaptureWelcome_Recording"
                    Grid.Column="1"
                    TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    FontSize="20"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE8D6;" />
                <TextBlock
                    x:Uid="CaptureWelcome_Names"
                    Grid.Column="1"
                    TextWrapping="Wrap" />
            </Grid>
        </StackPanel>
        <TextBlock
            x:Uid="CaptureWelcome_Consent"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
