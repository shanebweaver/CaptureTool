<UserControl
    x:Class="CaptureTool.Presentation.Windows.WinUI.Xaml.Controls.CaptureAnalysisWelcome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18" MaxWidth="420">
        <Border CornerRadius="16" Height="126" BorderThickness="1" BorderBrush="#806CAFFF">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop Color="#161B44" Offset="0" />
                    <GradientStop Color="#554199" Offset="0.55" />
                    <GradientStop Color="#197779" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Ellipse Width="124" Height="124" HorizontalAlignment="Right" Opacity=".45">
                    <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFC7F4FF" Offset="0" /><GradientStop Color="#00C7F4FF" Offset="1" /></LinearGradientBrush></Ellipse.Fill>
                </Ellipse>
                <Path Data="M 36,0 C 40,23 49,32 72,36 C 49,40 40,49 36,72 C 32,49 23,40 0,36 C 23,32 32,23 36,0 Z"
                      Width="72" Height="72" Fill="#EEF6FF" HorizontalAlignment="Right" Margin="0,0,32,0" VerticalAlignment="Center" />
                <Path Data="M 12,0 L 15,9 24,12 15,15 12,24 9,15 0,12 9,9 Z"
                      Fill="#A9E9F7" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,18,0" />
                <Path Data="M 7,0 L 9,5 14,7 9,9 7,14 5,9 0,7 5,5 Z"
                      Fill="#DECCFF" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,118,17" />
                <StackPanel Margin="20" VerticalAlignment="Center" Spacing="8" Padding="0,0,125,0">
                    <TextBlock x:Uid="CaptureWelcome_Eyebrow" FontSize="11" CharacterSpacing="100" Foreground="#D8E2FF" TextWrapping="Wrap" />
                    <TextBlock x:Uid="CaptureWelcome_Hero" FontSize="23" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8D2;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Grid.Column="1" x:Uid="CaptureWelcome_Text" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE720;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Grid.Column="1" x:Uid="CaptureWelcome_Recording" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8D6;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Grid.Column="1" x:Uid="CaptureWelcome_Names" TextWrapping="Wrap" />
            </Grid>
        </StackPanel>
        <TextBlock x:Uid="CaptureWelcome_Consent" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</UserControl>
