<ContentDialog
    x:Class="CaptureTool.Presentation.Windows.WinUI.Xaml.Controls.CaptureDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:details="using:CaptureTool.Presentation.Features.CaptureDetails"
    xmlns:utils="using:CaptureTool.Presentation.Windows.WinUI.Utils"
    x:Uid="CaptureDetails_Dialog"
    AutomationProperties.AutomationId="CaptureDetailsDialog"
    DefaultButton="Close">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
        <DataTemplate x:Key="EvidenceTemplate" x:DataType="details:CaptureDetailEvidence">
            <StackPanel Margin="0,0,0,12" Spacing="4">
                <TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Text}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="DetailTemplate" x:DataType="details:CaptureDetailItem">
            <Border Margin="0,0,0,10" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Text}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <Expander x:Uid="CaptureDetails_Evidence" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(HasEvidence)}">
                            <ItemsControl ItemsSource="{x:Bind Evidence}" ItemTemplate="{StaticResource EvidenceTemplate}" />
                        </Expander>
                    </StackPanel>
                    <Button Grid.Column="1" x:Uid="CaptureDetails_Copy" VerticalAlignment="Top" Tag="{x:Bind Text}" Click="Copy_Click">
                        <SymbolIcon Symbol="Copy" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PropertyTemplate" x:DataType="details:CaptureDetailItem">
            <StackPanel Margin="0,0,0,12" Spacing="3">
                <TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind Text}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </ContentDialog.Resources>
    <Grid Width="640" MaxWidth="{x:Bind ContentWidth, Mode=OneWay}" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock AutomationProperties.AutomationId="CaptureDetailsFileName" Text="{x:Bind ViewModel.FileName, Mode=OneWay}"
                       FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Uid="CaptureDetails_Refresh" AutomationProperties.AutomationId="CaptureDetailsRefresh"
                    Command="{x:Bind ViewModel.RefreshCommand}"><SymbolIcon Symbol="Refresh" /></Button>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="18" Padding="0,0,12,8">
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsReading), Mode=OneWay}" />
                <InfoBar IsOpen="{x:Bind ViewModel.ShowStatus, Mode=OneWay}" IsClosable="False" Severity="Informational"
                         Message="{x:Bind ViewModel.StatusText, Mode=OneWay}" AutomationProperties.AutomationId="CaptureDetailsStatus" />
                <StackPanel Spacing="10" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.Content.HasOverview), Mode=OneWay}">
                    <TextBlock x:Uid="CaptureDetails_OverviewHeading" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="CaptureDetails_SuggestionsHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl AutomationProperties.AutomationId="CaptureDetailsOverview" ItemsSource="{x:Bind ViewModel.Content.Overview, Mode=OneWay}" ItemTemplate="{StaticResource DetailTemplate}" />
                </StackPanel>
                <StackPanel Spacing="10" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.Content.HasFacts), Mode=OneWay}">
                    <TextBlock x:Uid="CaptureDetails_FactsHeading" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ItemsControl AutomationProperties.AutomationId="CaptureDetailsFacts" ItemsSource="{x:Bind ViewModel.Content.Facts, Mode=OneWay}" ItemTemplate="{StaticResource DetailTemplate}" />
                </StackPanel>
                <StackPanel Spacing="10" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.Content.HasSources), Mode=OneWay}">
                    <TextBlock x:Uid="CaptureDetails_SourcesHeading" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Content.Sources, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="details:CaptureDetailSection">
                                <Expander Header="{x:Bind Title}" Margin="0,0,0,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="10">
                                        <Button x:Uid="CaptureDetails_CopyAll" HorizontalAlignment="Left" Tag="{x:Bind CopyText}" Click="Copy_Click" />
                                        <ListView MaxHeight="320" ItemsSource="{x:Bind Items}" ItemTemplate="{StaticResource PropertyTemplate}"
                                                  SelectionMode="None" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                        </ListView>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Expander x:Uid="CaptureDetails_PropertiesHeading" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.Content.HasProperties), Mode=OneWay}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Content.Properties, Mode=OneWay}" ItemTemplate="{StaticResource PropertyTemplate}" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.CopyStatus, Mode=OneWay}" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="CaptureDetailsCopyStatus" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</ContentDialog>
