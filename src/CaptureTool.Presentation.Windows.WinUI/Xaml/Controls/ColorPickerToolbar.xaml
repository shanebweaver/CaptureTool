<?xml version="1.0" encoding="utf-8" ?>
<local:UserControlBase
    x:Class="CaptureTool.Presentation.Windows.WinUI.Xaml.Controls.ColorPickerToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CaptureTool.Presentation.Windows.WinUI.Xaml.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CaptureTool.Presentation.Windows.WinUI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ColorPickerToolbar}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:ColorTypeConverter x:Key="ColorTypeConverter" />
    </UserControl.Resources>

    <Border
        Padding="8,6"
        Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource SystemControlBackgroundBaseLowBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Translation="0,0,16">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox
                x:Name="ColorTypeComboBox"
                x:Uid="ColorPickerToolbar_ColorTypeComboBox"
                MinWidth="92"
                MinHeight="34"
                AutomationProperties.Name="Color format"
                Background="Transparent"
                BorderBrush="Transparent"
                SelectedIndex="{x:Bind SelectedColorTypeIndex, Mode=OneWay}"
                SelectionChanged="ColorTypeComboBox_SelectionChanged"
                ToolTipService.ToolTip="Choose color format">
                <ComboBoxItem Content="HEX" />
                <ComboBoxItem Content="RGB" />
                <ComboBoxItem Content="HSL" />
            </ComboBox>

            <Border
                Width="34"
                Height="34"
                VerticalAlignment="Center"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Rectangle RadiusX="3" RadiusY="3">
                    <Rectangle.Fill>
                        <SolidColorBrush Color="{x:Bind PickedColor, Mode=OneWay, Converter={StaticResource ColorTypeConverter}}" />
                    </Rectangle.Fill>
                </Rectangle>
            </Border>

            <TextBox
                x:Name="ColorValueTextBox"
                x:Uid="ColorPickerToolbar_ColorValueTextBox"
                Width="172"
                MinHeight="34"
                VerticalAlignment="Center"
                AutomationProperties.Name="Color value"
                IsReadOnly="True"
                Text="{x:Bind PickedColorValue, Mode=OneWay}"
                TextAlignment="Left" />
        </StackPanel>
    </Border>
</local:UserControlBase>
