<UserControl
    x:Class="CaptureTool.Presentation.Windows.WinUI.Xaml.Controls.CaptureDetailsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:details="using:CaptureTool.Presentation.Features.CaptureDetails"
    xmlns:utils="using:CaptureTool.Presentation.Windows.WinUI.Utils"
    AutomationProperties.AutomationId="CaptureDetailsPane" AutomationProperties.AccessibilityView="Control">
    <UserControl.Resources>
        <DataTemplate x:Key="PropertyTemplate" x:DataType="details:CaptureProperty">
            <Grid ColumnSpacing="12" Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontSize="12" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Padding="16,12" RowSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
          AutomationProperties.AccessibilityView="Raw">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="CapturePane_Heading" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" MaxLines="2" TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="CaptureDetailsFileName" />
                <TextBlock Text="{x:Bind ViewModel.FileProperties.Compact, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" x:Uid="CapturePane_Close" VerticalAlignment="Top" Click="Close_Click" Style="{StaticResource SubtleButtonStyle}">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel Spacing="12" Padding="0,0,8,8">
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsReadingFile), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.FileStatus, Mode=OneWay}" TextWrapping="Wrap"
                           Visibility="{x:Bind TextVisibility(ViewModel.FileStatus), Mode=OneWay}" />
                <InfoBar x:Uid="CapturePane_PendingEdits" IsOpen="{x:Bind ViewModel.HasEdits, Mode=OneWay}" IsClosable="False" Severity="Informational"
                         Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasEdits), Mode=OneWay}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.FileProperties.Basic, Mode=OneWay}" ItemTemplate="{StaticResource PropertyTemplate}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="CapturePane_CopyPath" Command="{x:Bind ViewModel.CopyPathCommand, Mode=OneWay}" />
                    <Button x:Uid="CapturePane_OpenFolder" Command="{x:Bind ViewModel.OpenFolderCommand, Mode=OneWay}" />
                </StackPanel>
                <Expander x:Uid="CapturePane_Technical" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.FileProperties.HasTechnical), Mode=OneWay}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.FileProperties.Technical, Mode=OneWay}" ItemTemplate="{StaticResource PropertyTemplate}" />
                </Expander>
                <StackPanel Spacing="6" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasSummary), Mode=OneWay}">
                    <TextBlock x:Uid="CapturePane_Summary" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                           Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasSummary), Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="CaptureDetailsStatus" />
                <Button x:Uid="CaptureDetails_Refresh" Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" HorizontalAlignment="Left">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.CopyStatus, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                   AutomationProperties.AutomationId="CaptureDetailsCopyStatus" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
