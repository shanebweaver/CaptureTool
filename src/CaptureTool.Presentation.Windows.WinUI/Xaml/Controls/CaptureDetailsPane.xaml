<UserControl
    x:Class="CaptureTool.Presentation.Windows.WinUI.Xaml.Controls.CaptureDetailsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:details="using:CaptureTool.Presentation.Features.CaptureDetails"
    xmlns:local="using:CaptureTool.Presentation.Windows.WinUI.Xaml.Controls"
    xmlns:utils="using:CaptureTool.Presentation.Windows.WinUI.Utils"
    AutomationProperties.AccessibilityView="Control"
    AutomationProperties.AutomationId="CaptureDetailsPane">
    <UserControl.Resources>
        <DataTemplate x:Key="AnalysisActionTemplate" x:DataType="details:CaptureAnalysisAction">
            <StackPanel Spacing="4">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind utils:VisibilityUtility.InverseBoolToVisibility(HasResult), Mode=OneWay}">
                    <ProgressRing
                        Width="16"
                        Height="16"
                        MinWidth="0"
                        MinHeight="0"
                        IsActive="{x:Bind IsRunning, Mode=OneWay}"
                        Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(IsRunning), Mode=OneWay}" />
                    <Button
                        AutomationProperties.AutomationId="{x:Bind Id}"
                        Command="{x:Bind Command}"
                        Content="{x:Bind Label}" />
                </StackPanel>
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Status, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(HasStatus), Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PropertyTemplate" x:DataType="details:CaptureProperty">
            <Grid Margin="0,5" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Label}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="1"
                    FontSize="12"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind Value}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid
        Padding="16,12"
        AutomationProperties.AccessibilityView="Raw"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="1,0,0,0"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="CapturePane_Heading" FontWeight="SemiBold" />
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="CaptureDetailsFileName"
                        IsTextSelectionEnabled="True"
                        MaxLines="2"
                        Text="{x:Bind ViewModel.FileName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <Button
                        x:Uid="CaptureNaming_Edit"
                        Grid.Column="1"
                        Padding="6"
                        AutomationProperties.AutomationId="CaptureName_Edit"
                        Command="{x:Bind ViewModel.EditNameCommand, Mode=OneWay}"
                        Style="{StaticResource SubtleButtonStyle}"
                        Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.CanEditName), Mode=OneWay}">
                        <FontIcon FontSize="12" Glyph="&#xE70F;" />
                    </Button>
                </Grid>

                <StackPanel Spacing="6" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasSuggestedName), Mode=OneWay}">
                    <TextBlock
                        x:Uid="CaptureNaming_Suggestion"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        AutomationProperties.AutomationId="CaptureName_Suggestion"
                        Text="{x:Bind ViewModel.SuggestedName, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Uid="CaptureNaming_Accept"
                        AutomationProperties.AutomationId="CaptureName_Accept"
                        Command="{x:Bind ViewModel.AcceptNameCommand, Mode=OneWay}" />
                </StackPanel>
                <ContentControl Content="{x:Bind ViewModel.NameAction, Mode=OneWay}" ContentTemplate="{StaticResource AnalysisActionTemplate}" />
                <Grid ColumnSpacing="4" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsEditingName), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="NameInput"
                        x:Uid="CaptureNaming_Input"
                        AutomationProperties.AutomationId="CaptureName_Input"
                        MaxLength="160"
                        Text="{x:Bind ViewModel.NameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        x:Uid="CaptureNaming_Save"
                        Grid.Column="1"
                        Padding="8"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="CaptureName_Save"
                        Command="{x:Bind ViewModel.SaveNameCommand, Mode=OneWay}"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE73E;" />
                    </Button>
                    <Button
                        x:Uid="CaptureNaming_Cancel"
                        Grid.Column="2"
                        Padding="8"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="CaptureName_Cancel"
                        Command="{x:Bind ViewModel.CancelNameCommand, Mode=OneWay}"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                    </Button>
                </Grid>
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="12"
                    Text="{x:Bind ViewModel.NameStatus, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind TextVisibility(ViewModel.NameStatus), Mode=OneWay}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.FileProperties.Compact, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                x:Uid="CapturePane_Close"
                Grid.Column="1"
                VerticalAlignment="Top"
                Click="Close_Click"
                Style="{StaticResource SubtleButtonStyle}">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
            </Button>
        </Grid>
        <Pivot
            x:Name="ContentTabs"
            Grid.Row="1"
            SelectionChanged="ContentTabs_SelectionChanged">
            <PivotItem x:Uid="CapturePane_DetailsTab" AutomationProperties.AutomationId="CapturePane_DetailsTab">
                <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="0,0,8,8" Spacing="12">
                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsReadingFile), Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.FileStatus, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind TextVisibility(ViewModel.FileStatus), Mode=OneWay}" />
                        <InfoBar
                            x:Uid="CapturePane_PendingEdits"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.HasEdits, Mode=OneWay}"
                            Severity="Informational"
                            Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasEdits), Mode=OneWay}" />
                        <Grid Margin="0,5" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="CaptureNaming_FileName"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.PhysicalFileName, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>
                        <ItemsControl ItemTemplate="{StaticResource PropertyTemplate}" ItemsSource="{x:Bind ViewModel.FileProperties.Basic, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="CapturePane_CopyPath" Command="{x:Bind ViewModel.CopyPathCommand, Mode=OneWay}" />
                            <Button x:Uid="CapturePane_OpenFolder" Command="{x:Bind ViewModel.OpenFolderCommand, Mode=OneWay}" />
                        </StackPanel>
                        <Expander
                            x:Uid="CapturePane_Technical"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.FileProperties.HasTechnical), Mode=OneWay}">
                            <ItemsControl ItemTemplate="{StaticResource PropertyTemplate}" ItemsSource="{x:Bind ViewModel.FileProperties.Technical, Mode=OneWay}" />
                        </Expander>

                        <StackPanel Spacing="6" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasVisualMedia), Mode=OneWay}">
                            <TextBlock x:Uid="CaptureAction_DescriptionHeading" FontWeight="SemiBold" />
                            <ContentControl Content="{x:Bind ViewModel.DescriptionAction, Mode=OneWay}" ContentTemplate="{StaticResource AnalysisActionTemplate}" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.Content.Description, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind TextVisibility(ViewModel.Content.Description), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="CapturePane_Summary" FontWeight="SemiBold" />
                            <ContentControl Content="{x:Bind ViewModel.SummaryAction, Mode=OneWay}" ContentTemplate="{StaticResource AnalysisActionTemplate}" />
                            <TextBlock
                                x:Uid="CaptureAction_SummaryInputs"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.NeedsSummaryInputs), Mode=OneWay}" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            AutomationProperties.AutomationId="CaptureDetailsStatus"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.SummaryNotice, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind TextVisibility(ViewModel.SummaryNotice), Mode=OneWay}" />

                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem AutomationProperties.AutomationId="CapturePane_TextTab" Header="{x:Bind ViewModel.ContentTabTitle, Mode=OneWay}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="6" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasVisualMedia), Mode=OneWay}">
                            <ContentControl Content="{x:Bind ViewModel.TextAction, Mode=OneWay}" ContentTemplate="{StaticResource AnalysisActionTemplate}" />
                            <ContentControl Content="{x:Bind ViewModel.QrAction, Mode=OneWay}" ContentTemplate="{StaticResource AnalysisActionTemplate}" />
                        </StackPanel>
                        <ContentControl
                            Content="{x:Bind ViewModel.TranscriptAction, Mode=OneWay}"
                            ContentTemplate="{StaticResource AnalysisActionTemplate}"
                            Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasAudio), Mode=OneWay}" />
                        <TextBox
                            x:Uid="CapturePane_Search"
                            AutomationProperties.AutomationId="CapturePane_Search"
                            MaxLength="256"
                            Text="{x:Bind ViewModel.TextContent.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            x:Uid="CapturePane_SourceFilter"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.TextContent.Filters, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.TextContent.SelectedFilter, Mode=TwoWay}"
                            Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.TextContent.HasSources), Mode=OneWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="details:CaptureTextFilter">
                                    <TextBlock Text="{x:Bind Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsReading), Mode=OneWay}" />
                        <TextBlock
                            FontSize="12"
                            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind TextVisibility(ViewModel.StatusText), Mode=OneWay}" />
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="CapturePane_MatchCount"
                            AutomationProperties.LiveSetting="Polite"
                            FontSize="12"
                            Text="{x:Bind ViewModel.TextContent.CountText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Button
                            x:Uid="CapturePane_Previous"
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.TextContent.PreviousCommand, Mode=OneWay}">
                            <FontIcon FontSize="12" Glyph="&#xE70E;" />
                        </Button>
                        <Button
                            x:Uid="CapturePane_Next"
                            Grid.Column="2"
                            Command="{x:Bind ViewModel.TextContent.NextCommand, Mode=OneWay}">
                            <FontIcon FontSize="12" Glyph="&#xE70D;" />
                        </Button>
                    </Grid>
                    <ListView
                        x:Name="Passages"
                        Grid.Row="2"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="CapturePane_Passages"
                        ItemsSource="{x:Bind ViewModel.TextContent.Visible, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.TextContent.SelectedPassage, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="details:CaptureTextPassage">
                                <Grid
                                    Padding="4,6"
                                    ColumnSpacing="4"
                                    RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <local:CapturePassageText
                                        VerticalAlignment="Center"
                                        Query="{x:Bind Query, Mode=OneWay}"
                                        Text="{x:Bind Text}" />
                                    <Button
                                        Grid.Column="1"
                                        Padding="6"
                                        VerticalAlignment="Top"
                                        AutomationProperties.Name="{x:Bind NavigationLabel, Mode=OneWay}"
                                        Click="Navigate_Click"
                                        IsEnabled="{x:Bind CanNavigate, Mode=OneWay}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="{x:Bind NavigationLabel, Mode=OneWay}">
                                        <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                    </Button>
                                    <Button
                                        x:Uid="CaptureDetails_Copy"
                                        Grid.Column="2"
                                        Padding="6"
                                        VerticalAlignment="Top"
                                        Click="Copy_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Tag="{x:Bind Text}">
                                        <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                    </Button>
                                    <StackPanel
                                        Grid.Row="1"
                                        Grid.ColumnSpan="3"
                                        Spacing="4">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind SelectedLocation.Label, Mode=OneWay}"
                                            Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(IsTimed), Mode=OneWay}" />
                                        <ComboBox
                                            x:Uid="CapturePane_Occurrences"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{x:Bind Locations}"
                                            SelectedItem="{x:Bind SelectedLocation, Mode=TwoWay}"
                                            Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(HasOccurrences)}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="details:CaptureTextLocation">
                                                    <TextBlock Text="{x:Bind Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button
                                            x:Uid="CapturePane_OpenLink"
                                            HorizontalAlignment="Left"
                                            Click="OpenLink_Click"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(HasWebLink)}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="3" Spacing="6">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.TextContent.SelectedPassage.NavigationHint, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind TextVisibility(ViewModel.TextContent.SelectedPassage.NavigationHint), Mode=OneWay}" />
                        <Button
                            x:Uid="CapturePane_LoadMore"
                            Command="{x:Bind ViewModel.TextContent.LoadMoreCommand, Mode=OneWay}"
                            Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.TextContent.HasMore), Mode=OneWay}" />
                        <Button
                            x:Uid="CapturePane_CopyResults"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="CapturePane_CopyResults"
                            Command="{x:Bind ViewModel.CopyResultsCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.TextContent.HasText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</UserControl>
