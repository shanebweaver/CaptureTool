<UserControl
    x:Class="CaptureTool.Presentation.Windows.WinUI.Xaml.Controls.CaptureDetailsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CaptureTool.Presentation.Windows.WinUI.Xaml.Controls"
    xmlns:details="using:CaptureTool.Presentation.Features.CaptureDetails"
    xmlns:utils="using:CaptureTool.Presentation.Windows.WinUI.Utils"
    AutomationProperties.AutomationId="CaptureDetailsPane" AutomationProperties.AccessibilityView="Control">
    <UserControl.Resources>
        <DataTemplate x:Key="PropertyTemplate" x:DataType="details:CaptureProperty">
            <Grid ColumnSpacing="12" Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontSize="12" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Padding="16,12" RowSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
          AutomationProperties.AccessibilityView="Raw">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="CapturePane_Heading" FontWeight="SemiBold" />
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" MaxLines="2" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="CaptureDetailsFileName" />
                    <Button Grid.Column="1" x:Uid="CaptureNaming_Edit" AutomationProperties.AutomationId="CaptureName_Edit"
                            Style="{StaticResource SubtleButtonStyle}" Command="{x:Bind ViewModel.EditNameCommand, Mode=OneWay}"
                            Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.CanEditName), Mode=OneWay}" Padding="6">
                        <FontIcon Glyph="&#xE70F;" FontSize="12" />
                    </Button>
                </Grid>
                <StackPanel Spacing="6" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsEditingName), Mode=OneWay}">
                    <TextBox x:Name="NameInput" x:Uid="CaptureNaming_Input" MaxLength="160" AutomationProperties.AutomationId="CaptureName_Input"
                             Text="{x:Bind ViewModel.NameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock x:Uid="CaptureNaming_EditHint" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="CaptureNaming_Save" AutomationProperties.AutomationId="CaptureName_Save" Command="{x:Bind ViewModel.SaveNameCommand, Mode=OneWay}" />
                        <Button x:Uid="CaptureNaming_Cancel" Command="{x:Bind ViewModel.CancelNameCommand, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.NameStatus, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                               Visibility="{x:Bind TextVisibility(ViewModel.NameStatus), Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.FileProperties.Compact, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" x:Uid="CapturePane_Close" VerticalAlignment="Top" Click="Close_Click" Style="{StaticResource SubtleButtonStyle}">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>
        <Pivot Grid.Row="1" x:Name="ContentTabs" SelectionChanged="ContentTabs_SelectionChanged">
            <PivotItem x:Uid="CapturePane_DetailsTab" AutomationProperties.AutomationId="CapturePane_DetailsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                    <StackPanel Spacing="12" Padding="0,0,8,8">
                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsReadingFile), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.FileStatus, Mode=OneWay}" TextWrapping="Wrap"
                                   Visibility="{x:Bind TextVisibility(ViewModel.FileStatus), Mode=OneWay}" />
                        <InfoBar x:Uid="CapturePane_PendingEdits" IsOpen="{x:Bind ViewModel.HasEdits, Mode=OneWay}" IsClosable="False" Severity="Informational"
                                 Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasEdits), Mode=OneWay}" />
                        <Grid ColumnSpacing="12" Margin="0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock x:Uid="CaptureNaming_FileName" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PhysicalFileName, Mode=OneWay}" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FileProperties.Basic, Mode=OneWay}" ItemTemplate="{StaticResource PropertyTemplate}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="CapturePane_CopyPath" Command="{x:Bind ViewModel.CopyPathCommand, Mode=OneWay}" />
                            <Button x:Uid="CapturePane_OpenFolder" Command="{x:Bind ViewModel.OpenFolderCommand, Mode=OneWay}" />
                        </StackPanel>
                        <Expander x:Uid="CapturePane_Technical" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.FileProperties.HasTechnical), Mode=OneWay}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.FileProperties.Technical, Mode=OneWay}" ItemTemplate="{StaticResource PropertyTemplate}" />
                        </Expander>
                        <StackPanel Spacing="6" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasSummary), Mode=OneWay}">
                            <TextBlock x:Uid="CapturePane_Summary" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.SummaryNotice, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                                   Visibility="{x:Bind TextVisibility(ViewModel.SummaryNotice), Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="CaptureDetailsStatus" />

                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="{x:Bind ViewModel.ContentTabTitle, Mode=OneWay}" AutomationProperties.AutomationId="CapturePane_TextTab">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <TextBox x:Uid="CapturePane_Search" AutomationProperties.AutomationId="CapturePane_Search" MaxLength="256"
                                 Text="{x:Bind ViewModel.TextContent.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox x:Uid="CapturePane_SourceFilter" HorizontalAlignment="Stretch"
                                  Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.TextContent.HasSources), Mode=OneWay}"
                                  ItemsSource="{x:Bind ViewModel.TextContent.Filters, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.TextContent.SelectedFilter, Mode=TwoWay}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="details:CaptureTextFilter"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsReading), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                   Visibility="{x:Bind TextVisibility(ViewModel.StatusText), Mode=OneWay}" />
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.TextContent.CountText, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="CapturePane_MatchCount" />
                        <Button Grid.Column="1" x:Uid="CapturePane_Previous" Command="{x:Bind ViewModel.TextContent.PreviousCommand, Mode=OneWay}"><FontIcon Glyph="&#xE70E;" FontSize="12" /></Button>
                        <Button Grid.Column="2" x:Uid="CapturePane_Next" Command="{x:Bind ViewModel.TextContent.NextCommand, Mode=OneWay}"><FontIcon Glyph="&#xE70D;" FontSize="12" /></Button>
                    </Grid>
                    <ListView Grid.Row="2" x:Name="Passages" AutomationProperties.AutomationId="CapturePane_Passages"
                              ItemsSource="{x:Bind ViewModel.TextContent.Visible, Mode=OneWay}" HorizontalContentAlignment="Stretch"
                              SelectedItem="{x:Bind ViewModel.TextContent.SelectedPassage, Mode=TwoWay}" SelectionMode="Single">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="details:CaptureTextPassage">
                                <StackPanel Padding="6,8" Spacing="5">
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button Tag="{x:Bind}" Click="Navigate_Click" IsEnabled="{x:Bind CanNavigate, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind NavigationLabel, Mode=OneWay}"
                                                Style="{StaticResource SubtleButtonStyle}" Padding="0,4" HorizontalAlignment="Left"
                                                ToolTipService.ToolTip="{x:Bind NavigationHint, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(IsTimed), Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind SelectedLocation.Label, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" x:Uid="CaptureDetails_Copy" Tag="{x:Bind Text}" Click="Copy_Click"
                                                Style="{StaticResource SubtleButtonStyle}" Padding="6"><FontIcon Glyph="&#xE8C8;" FontSize="12" /></Button>
                                    </Grid>
                                    <local:CapturePassageText Text="{x:Bind Text}" Query="{x:Bind Query, Mode=OneWay}" />
                                    <ComboBox x:Uid="CapturePane_Occurrences" ItemsSource="{x:Bind Locations}" SelectedItem="{x:Bind SelectedLocation, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(HasOccurrences)}">
                                        <ComboBox.ItemTemplate><DataTemplate x:DataType="details:CaptureTextLocation"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Uid="CapturePane_OpenLink" Tag="{x:Bind}" Click="OpenLink_Click" HorizontalAlignment="Left"
                                            Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(HasWebLink)}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="3" Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.TextContent.SelectedPassage.NavigationHint, Mode=OneWay}" Visibility="{x:Bind TextVisibility(ViewModel.TextContent.SelectedPassage.NavigationHint), Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Uid="CapturePane_LoadMore" Command="{x:Bind ViewModel.TextContent.LoadMoreCommand, Mode=OneWay}"
                                Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.TextContent.HasMore), Mode=OneWay}" />
                        <Button x:Uid="CapturePane_CopyResults" AutomationProperties.AutomationId="CapturePane_CopyResults" HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.TextContent.HasText, Mode=OneWay}" Command="{x:Bind ViewModel.CopyResultsCommand, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </PivotItem>
        </Pivot>
        <Grid Grid.Row="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind ViewModel.CopyStatus, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                   AutomationProperties.AutomationId="CaptureDetailsCopyStatus" AutomationProperties.LiveSetting="Polite" />
        <Button Grid.Column="1" x:Uid="CaptureDetails_Refresh" Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"><SymbolIcon Symbol="Refresh" /></Button>
        </Grid>
    </Grid>
</UserControl>
