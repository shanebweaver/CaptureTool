<?xml version="1.0" encoding="utf-8" ?>
<local:UserControlBase
    x:Class="CaptureTool.Presentation.Windows.WinUI.Xaml.Controls.AnalyzedContentPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:analyzed="using:CaptureTool.Presentation.Features.AnalyzedContent"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CaptureTool.Presentation.Windows.WinUI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="using:CaptureTool.Presentation.Windows.WinUI.Utils"
    mc:Ignorable="d">

    <Border
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,0,0,0">
        <Grid Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Uid="AnalyzedContent_Title"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Analyzed content" />
                <Button
                    x:Uid="AnalyzedContent_ReanalyzeAll"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="AnalyzedContent_ReanalyzeAllButton"
                    Command="{x:Bind ViewModel.ReanalyzeAllCommand}"
                    Content="Reanalyze all"
                    Style="{StaticResource SubtleButtonStyle}" />
                <Button
                    x:Uid="AnalyzedContent_Close"
                    Grid.Column="2"
                    AutomationProperties.Name="Close analyzed content"
                    Command="{x:Bind ViewModel.ClosePaneCommand}"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE711;" />
                </Button>
            </Grid>

            <TextBlock
                x:Uid="AnalyzedContent_NoContent"
                Grid.Row="1"
                Margin="0,20,0,0"
                Opacity="0.7"
                Text="No analyzed content is available for this capture."
                TextWrapping="Wrap"
                Visibility="{x:Bind utils:VisibilityUtility.InverseBoolToVisibility(ViewModel.HasContent), Mode=OneWay}" />

            <ListView
                x:Name="SectionList"
                Grid.Row="1"
                Margin="0,12,0,8"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.Sections}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollMode="Disabled"
                SelectedItem="{x:Bind ViewModel.SelectedSection, Mode=TwoWay}"
                SelectionMode="Single"
                Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasContent), Mode=OneWay}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="analyzed:AnalyzedContentSectionViewModel">
                        <TextBlock Text="{x:Bind Title}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid
                Grid.Row="2"
                Margin="0,0,0,8"
                ColumnSpacing="4"
                Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasContent), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.SelectedSection.Title, Mode=OneWay}" />
                <Button
                    x:Uid="AnalyzedContent_ReanalyzeTab"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="AnalyzedContent_ReanalyzeTabButton"
                    Command="{x:Bind ViewModel.ReanalyzeSelectedCommand, Mode=OneWay}"
                    Content="Reanalyze"
                    Style="{StaticResource SubtleButtonStyle}" />
                <Button
                    x:Uid="AnalyzedContent_CopyAll"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="AnalyzedContent_CopyAllButton"
                    Command="{x:Bind ViewModel.SelectedSection.CopyAllCommand, Mode=OneWay}"
                    Content="Copy all"
                    Style="{StaticResource SubtleButtonStyle}" />
            </Grid>

            <Grid Grid.Row="3" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasContent), Mode=OneWay}">
                <ListView
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.SelectedSection.Items, Mode=OneWay}"
                    SelectionMode="None"
                    Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasSelectedItems), Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="analyzed:AnalyzedContentItemViewModel">
                            <ToggleButton
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                 Command="{x:Bind ActivateCommand}"
                                 IsChecked="{x:Bind IsHighlighted, Mode=OneWay}"
                                 IsEnabled="{x:Bind CanActivate, Mode=OneWay}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        MinWidth="42"
                                        FontFamily="Consolas"
                                        Opacity="0.7"
                                        Text="{x:Bind TimecodeLabel}"
                                        Visibility="{x:Bind HasTimecode}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.7"
                                            Text="{x:Bind SecondaryLabel}"
                                            Visibility="{x:Bind HasSecondaryLabel}" />
                                    </StackPanel>
                                </Grid>
                            </ToggleButton>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBox
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    Text="{x:Bind ViewModel.SelectedSection.FullText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.ShowSelectedFullText), Mode=OneWay}" />

                <TextBlock
                    Margin="0,8,0,0"
                    Opacity="0.7"
                    Text="{x:Bind ViewModel.SelectedSection.EmptyMessage, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.ShowSelectedEmpty), Mode=OneWay}" />
            </Grid>
        </Grid>
    </Border>
</local:UserControlBase>
