<?xml version="1.0" encoding="utf-8" ?>
<local:AudioEditPageBase
    x:Class="CaptureTool.Presentation.Windows.WinUI.Xaml.Pages.AudioEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:audio="using:CaptureTool.Presentation.Features.Audio"
    xmlns:audioedit="using:CaptureTool.Presentation.Features.AudioEdit"
    xmlns:controls="using:CaptureTool.Presentation.Windows.WinUI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CaptureTool.Presentation.Windows.WinUI.Xaml.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="using:CaptureTool.Presentation.Windows.WinUI.Utils"
    d:DataContext="{d:DesignInstance Type=audioedit:AudioEditPageViewModel}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <CommandBar
            HorizontalAlignment="Stretch"
            DefaultLabelPosition="Right"
            IsOpen="False">
            <!--  Open in Clipchamp  -->
            <AppBarButton
                x:Uid="AudioEdit_OpenInClipchampButton"
                Command="{x:Bind ViewModel.OpenInClipchampCommand}"
                Icon="Edit"
                IsEnabled="{x:Bind ViewModel.IsMediaReady, Mode=OneWay}">
                <AppBarButton.Label>Open in Clipchamp</AppBarButton.Label>
            </AppBarButton>

            <!--  Copy  -->
            <AppBarButton
                x:Uid="AudioEdit_CopyButton"
                Command="{x:Bind ViewModel.CopyCommand}"
                Icon="Copy"
                IsEnabled="{x:Bind ViewModel.IsMediaReady, Mode=OneWay}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="C" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>

            <!--  Save  -->
            <AppBarButton
                x:Uid="AudioEdit_SaveButton"
                Command="{x:Bind ViewModel.SaveCommand}"
                Icon="Save"
                IsEnabled="{x:Bind ViewModel.IsMediaReady, Mode=OneWay}">
                <AppBarButton.Label>Save as</AppBarButton.Label>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>

            <!--  Open audio recordings folder  -->
            <AppBarButton
                x:Uid="AudioEdit_OpenAudioFolderButton"
                Command="{x:Bind ViewModel.OpenAudioFolderCommand}"
                Icon="Folder" />

            <AppBarSeparator />
            <AppBarToggleButton
                x:Uid="AnalyzedContent_Open"
                AutomationProperties.AutomationId="AudioEdit_AnalyzedContentButton"
                Command="{x:Bind ViewModel.AnalyzedContent.TogglePaneCommand}"
                IsChecked="{x:Bind ViewModel.AnalyzedContent.IsPaneOpen, Mode=OneWay}">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE8A5;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
        </CommandBar>

        <SplitView
            x:Name="AnalyzedContentSplitView"
            Grid.Row="1"
            DisplayMode="Overlay"
            IsPaneOpen="{x:Bind ViewModel.AnalyzedContent.IsPaneOpen, Mode=TwoWay}"
            OpenPaneLength="380"
            PanePlacement="Right">
            <SplitView.Pane>
                <controls:AnalyzedContentPane ViewModel="{x:Bind ViewModel.AnalyzedContent}" />
            </SplitView.Pane>
            <Grid Padding="0">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Padding="20,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefault}"
                BorderBrush="{ThemeResource CardStrokeColorDefault}"
                BorderThickness="0,1"
                Visibility="{x:Bind ViewModel.IsMediaReady, Mode=OneWay}">
                <Grid
                    x:Name="WaveformSurface"
                    Grid.Row="1"
                    MaxHeight="300"
                    SizeChanged="WaveformSurface_SizeChanged">
                    <ScrollViewer
                        x:Name="WaveformScrollViewer"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled"
                        ZoomMode="Disabled">
                        <Grid x:Name="WaveformScrollContent" VerticalAlignment="Stretch">
                            <Grid
                                x:Name="WaveformTrack"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                PointerPressed="WaveformSurface_PointerPressed">
                                <ItemsRepeater
                                    x:Name="WaveformBarsRepeater"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    ItemsSource="{x:Bind ViewModel.WaveformBars, Mode=OneWay}"
                                    SizeChanged="WaveformBarsRepeater_SizeChanged">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="4" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="audio:AudioWaveformBarViewModel">
                                            <Border
                                                Width="{x:Bind Width, Mode=OneWay}"
                                                Height="{x:Bind Height, Mode=OneWay}"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="2" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>

                                <Border
                                    x:Name="WaveformPlayhead"
                                    Width="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="{ThemeResource TextFillColorPrimaryBrush}"
                                    IsHitTestVisible="False">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="WaveformPlayheadTransform" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <MediaPlayerElement
                x:Name="AudioPlayer"
                Grid.Row="1"
                AreTransportControlsEnabled="True"
                Visibility="{x:Bind ViewModel.IsMediaReady, Mode=OneWay}" />

            <Grid
                Grid.RowSpan="2"
                Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsMediaLoading), Mode=OneWay}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <ProgressRing
                        Width="48"
                        Height="48"
                        IsActive="True" />
                    <TextBlock
                        x:Uid="AudioEdit_LoadingMediaText"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        Opacity="0.7"
                        Text="Opening audio..." />
                </StackPanel>
            </Grid>

            <Grid
                Grid.RowSpan="2"
                Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
                Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasMediaFailure), Mode=OneWay}">
                <StackPanel
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <FontIcon FontSize="32" Glyph="&#xE783;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="16"
                        Text="{x:Bind ViewModel.MediaFailureMessage, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Uid="MediaFailure_RetryButton"
                            Command="{x:Bind ViewModel.RetryMediaCommand}"
                            Content="Try again" />
                        <Button
                            x:Uid="AudioEdit_MediaFailureOpenFolderButton"
                            Command="{x:Bind ViewModel.OpenAudioFolderCommand}"
                            Content="Open audio recordings folder" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            </Grid>
        </SplitView>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AnalyzedContentSplitView.DisplayMode" Value="Inline" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>

</local:AudioEditPageBase>
