<?xml version="1.0" encoding="utf-8" ?>
<local:AudioEditPageBase
    x:Class="CaptureTool.Presentation.Windows.WinUI.Xaml.Pages.AudioEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:audio="using:CaptureTool.Presentation.Features.Audio"
    xmlns:audioedit="using:CaptureTool.Presentation.Features.AudioEdit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CaptureTool.Presentation.Windows.WinUI.Xaml.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=audioedit:AudioEditPageViewModel}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <CommandBar DefaultLabelPosition="Right" IsOpen="False">
            <!--  Copy  -->
            <AppBarButton
                x:Uid="AudioEdit_CopyButton"
                Command="{x:Bind ViewModel.CopyCommand}"
                Icon="Copy"
                IsEnabled="{x:Bind ViewModel.IsAudioReady, Mode=OneWay}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="C" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>

            <!--  Save  -->
            <AppBarButton
                x:Uid="AudioEdit_SaveButton"
                Command="{x:Bind ViewModel.SaveCommand}"
                Icon="Save"
                IsEnabled="{x:Bind ViewModel.IsAudioReady, Mode=OneWay}">
                <AppBarButton.Label>Save as</AppBarButton.Label>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
        </CommandBar>

        <Grid Grid.Row="1" Padding="0">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Padding="20,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefault}"
                BorderBrush="{ThemeResource CardStrokeColorDefault}"
                BorderThickness="0,1"
                Visibility="{x:Bind ViewModel.IsAudioReady, Mode=OneWay}">
                <Grid
                    MaxHeight="300"
                    x:Name="WaveformSurface"
                    Grid.Row="1"
                    SizeChanged="WaveformSurface_SizeChanged">
                    <ScrollViewer
                        x:Name="WaveformScrollViewer"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled"
                        ZoomMode="Disabled">
                        <Grid
                            x:Name="WaveformScrollContent"
                            VerticalAlignment="Stretch">
                            <Grid
                                x:Name="WaveformTrack"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                PointerPressed="WaveformSurface_PointerPressed">
                                <ItemsRepeater
                                    x:Name="WaveformBarsRepeater"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ItemsSource="{x:Bind ViewModel.WaveformBars, Mode=OneWay}"
                                    SizeChanged="WaveformBarsRepeater_SizeChanged">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="4" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="audio:AudioWaveformBarViewModel">
                                            <Border
                                                Width="{x:Bind Width, Mode=OneWay}"
                                                Height="{x:Bind Height, Mode=OneWay}"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="2" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>

                                <Border
                                    x:Name="WaveformPlayhead"
                                    Width="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="{ThemeResource TextFillColorPrimaryBrush}"
                                    IsHitTestVisible="False">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="WaveformPlayheadTransform" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <MediaPlayerElement
                x:Name="AudioPlayer"
                Grid.Row="1"
                AreTransportControlsEnabled="True"
                Visibility="{x:Bind ViewModel.IsAudioReady, Mode=OneWay}" />
        </Grid>
    </Grid>

</local:AudioEditPageBase>
