<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageBase
    x:Class="CaptureTool.Presentation.Windows.WinUI.Xaml.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CaptureTool.Presentation.Windows.WinUI.Xaml.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:CaptureTool.Presentation.Features.Settings"
    xmlns:utils="using:CaptureTool.Presentation.Windows.WinUI.Utils"
    xmlns:views="using:CaptureTool.Presentation.Windows.WinUI.Xaml.Views"
    d:DataContext="{d:DesignInstance Type=settings:SettingsPageViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="SettingsDreamBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FFF8FBFF" />
                        <GradientStop Offset=".34" Color="#FFEAF5FF" />
                        <GradientStop Offset=".7" Color="#FFECF8F3" />
                        <GradientStop Offset="1" Color="#FFFFF4E6" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SettingsAmbientRibbonBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0" Color="#00FFFFFF" />
                        <GradientStop Offset=".26" Color="#45A9DCFF" />
                        <GradientStop Offset=".56" Color="#4A9FEFD1" />
                        <GradientStop Offset=".8" Color="#3CFFD18A" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <LinearGradientBrush x:Key="SettingsDreamBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FF111820" />
                        <GradientStop Offset=".34" Color="#FF152B38" />
                        <GradientStop Offset=".7" Color="#FF18332D" />
                        <GradientStop Offset="1" Color="#FF352B1F" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SettingsAmbientRibbonBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0" Color="#00FFFFFF" />
                        <GradientStop Offset=".26" Color="#3D69B9F2" />
                        <GradientStop Offset=".56" Color="#3D64D0A2" />
                        <GradientStop Offset=".8" Color="#38F2C65D" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="SettingsDreamBackgroundBrush" ResourceKey="ApplicationPageBackgroundThemeBrush" />
                    <SolidColorBrush x:Key="SettingsAmbientRibbonBrush" Color="Transparent" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource SettingsDreamBackgroundBrush}">
        <Grid.Resources>
            <Storyboard
                x:Name="SettingsAmbientMotionStoryboard"
                AutoReverse="True"
                RepeatBehavior="Forever">
                <DoubleAnimation
                    Storyboard.TargetName="SettingsRibbonOneTransform"
                    Storyboard.TargetProperty="TranslateX"
                    From="-70"
                    To="90"
                    Duration="0:0:24" />
                <DoubleAnimation
                    Storyboard.TargetName="SettingsRibbonTwoTransform"
                    Storyboard.TargetProperty="TranslateY"
                    From="-30"
                    To="38"
                    Duration="0:0:21" />
                <DoubleAnimation
                    Storyboard.TargetName="SettingsRibbonThreeTransform"
                    Storyboard.TargetProperty="TranslateX"
                    From="60"
                    To="-70"
                    Duration="0:0:27" />
            </Storyboard>
        </Grid.Resources>

        <Grid IsHitTestVisible="False">
            <Border
                Width="780"
                Height="220"
                Margin="-240,52,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource SettingsAmbientRibbonBrush}"
                CornerRadius="110"
                Opacity=".28"
                RenderTransformOrigin=".5,.5">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="SettingsRibbonOneTransform" Rotation="-14" />
                </Border.RenderTransform>
            </Border>
            <Border
                Width="690"
                Height="210"
                Margin="0,190,-230,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{ThemeResource SettingsAmbientRibbonBrush}"
                CornerRadius="105"
                Opacity=".2"
                RenderTransformOrigin=".5,.5">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="SettingsRibbonTwoTransform" Rotation="16" />
                </Border.RenderTransform>
            </Border>
            <Border
                Width="820"
                Height="200"
                Margin="-160,0,0,52"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{ThemeResource SettingsAmbientRibbonBrush}"
                CornerRadius="100"
                Opacity=".17"
                RenderTransformOrigin=".5,.5">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="SettingsRibbonThreeTransform" Rotation="8" />
                </Border.RenderTransform>
            </Border>
        </Grid>

        <ScrollView>
            <StackPanel Padding="0,24" Spacing="24">
                <StackPanel
                    Margin="12,0"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Back"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Command="{x:Bind ViewModel.GoBackCommand, Mode=OneWay}">
                        <SymbolIcon Symbol="Back" />
                    </Button>
                    <TextBlock
                        x:Uid="Settings_HeaderLabel"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <StackPanel
                    x:Name="ContentPanel"
                    Margin="54,0"
                    MaxWidth="800"
                    HorizontalAlignment="Stretch"
                    Spacing="12">

                    <!--  Image Capture section  -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Settings_ImageCaptureHeaderLabel" Margin="0,4" />

                        <!--  Auto copy  -->
                        <Grid
                            Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefault}"
                            BorderBrush="{ThemeResource CardStrokeColorDefault}"
                            BorderThickness="1"
                            ColumnSpacing="16"
                            CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>

                            <SymbolIcon Symbol="Copy" />

                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    x:Uid="Settings_AutoCopy_HeaderLabel"
                                    MaxLines="2"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Uid="Settings_AutoCopy_SubtitleLabel"
                                    FontSize="12"
                                    MaxLines="2"
                                    Opacity=".75"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <ToggleSwitch
                                x:Uid="Settings_AutoCopy_Toggle"
                                Grid.Column="2"
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                IsOn="{x:Bind ViewModel.ImageCaptureAutoCopy, Mode=OneWay}"
                                Toggled="ImageAutoCopyToggleSwitch_Toggled" />
                        </Grid>

                        <!--  Auto save  -->
                        <Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="True">
                            <Expander.Header>
                                <Grid
                                    Padding="0,12"
                                    ColumnSpacing="16"
                                    CornerRadius="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <SymbolIcon Symbol="Save" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            x:Uid="Settings_AutoSave_HeaderLabel"
                                            MaxLines="2"
                                            TextTrimming="WordEllipsis"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            x:Uid="Settings_AutoSave_SubtitleLabel"
                                            FontSize="12"
                                            MaxLines="2"
                                            Opacity=".75"
                                            TextTrimming="WordEllipsis"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>

                                    <ToggleSwitch
                                        x:Uid="Settings_AutoSave_Toggle"
                                        Grid.Column="2"
                                        MinWidth="0"
                                        HorizontalAlignment="Right"
                                        IsOn="{x:Bind ViewModel.ImageCaptureAutoSave, Mode=OneWay}"
                                        Toggled="ImageAutoSaveToggleSwitch_Toggled" />
                                </Grid>
                            </Expander.Header>
                            <Grid Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        x:Uid="Settings_AutoSave_ScreenshotsFolderLabel"
                                        MaxLines="2"
                                        TextTrimming="WordEllipsis"
                                        TextWrapping="NoWrap" />
                                    <HyperlinkButton Command="{x:Bind ViewModel.OpenScreenshotsFolderCommand, Mode=OneWay}">
                                        <TextBlock
                                            MaxLines="2"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.ScreenshotsFolderPath, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </HyperlinkButton>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button Command="{x:Bind ViewModel.ChangeScreenshotsFolderCommand, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Viewbox Height="16">
                                                <SymbolIcon Symbol="Folder" />
                                            </Viewbox>
                                            <TextBlock x:Uid="Settings_AutoSave_ChangeButton" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Expander>
                    </StackPanel>

                    <!--  Audio Capture section  -->
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Uid="Settings_AudioCaptureHeaderLabel"
                            Margin="0,4"
                            Text="Audio capture" />

                        <!--  Default Local Audio  -->
                        <Grid
                            Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefault}"
                            BorderBrush="{ThemeResource CardStrokeColorDefault}"
                            BorderThickness="1"
                            ColumnSpacing="16"
                            CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>

                            <SymbolIcon Symbol="Volume" />

                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    x:Uid="Settings_AudioDefaultLocalAudio_HeaderLabel"
                                    MaxLines="2"
                                    Text="Capture system audio by default"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Uid="Settings_AudioDefaultLocalAudio_SubtitleLabel"
                                    FontSize="12"
                                    MaxLines="2"
                                    Opacity=".75"
                                    Text="Start new audio recordings with system audio enabled."
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <ToggleSwitch
                                x:Uid="Settings_AudioDefaultLocalAudio_Toggle"
                                Grid.Column="2"
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                IsOn="{x:Bind ViewModel.AudioCaptureDefaultLocalAudio, Mode=OneWay}"
                                Toggled="AudioDefaultLocalAudioToggleSwitch_Toggled" />
                        </Grid>

                        <!--  Auto copy  -->
                        <Grid
                            Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefault}"
                            BorderBrush="{ThemeResource CardStrokeColorDefault}"
                            BorderThickness="1"
                            ColumnSpacing="16"
                            CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>

                            <SymbolIcon Symbol="Copy" />

                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    x:Uid="Settings_AudioAutoCopy_HeaderLabel"
                                    MaxLines="2"
                                    Text="Copy audio after recording"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Uid="Settings_AudioAutoCopy_SubtitleLabel"
                                    FontSize="12"
                                    MaxLines="2"
                                    Opacity=".75"
                                    Text="Place completed WAV recordings on the clipboard."
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <ToggleSwitch
                                x:Uid="Settings_AudioAutoCopy_Toggle"
                                Grid.Column="2"
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                IsOn="{x:Bind ViewModel.AudioCaptureAutoCopy, Mode=OneWay}"
                                Toggled="AudioAutoCopyToggleSwitch_Toggled" />
                        </Grid>

                        <!--  Auto save  -->
                        <Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="True">
                            <Expander.Header>
                                <Grid
                                    Padding="0,12"
                                    ColumnSpacing="16"
                                    CornerRadius="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <SymbolIcon Symbol="Save" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            x:Uid="Settings_AudioAutoSave_HeaderLabel"
                                            MaxLines="2"
                                            Text="Save audio after recording"
                                            TextTrimming="WordEllipsis"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            x:Uid="Settings_AudioAutoSave_SubtitleLabel"
                                            FontSize="12"
                                            MaxLines="2"
                                            Opacity=".75"
                                            Text="Copy completed WAV recordings into your audio folder."
                                            TextTrimming="WordEllipsis"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>

                                    <ToggleSwitch
                                        x:Uid="Settings_AudioAutoSave_Toggle"
                                        Grid.Column="2"
                                        MinWidth="0"
                                        HorizontalAlignment="Right"
                                        IsOn="{x:Bind ViewModel.AudioCaptureAutoSave, Mode=OneWay}"
                                        Toggled="AudioAutoSaveToggleSwitch_Toggled" />
                                </Grid>
                            </Expander.Header>
                            <Grid Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        x:Uid="Settings_AudioAutoSave_AudioFolderLabel"
                                        MaxLines="2"
                                        Text="Audio folder"
                                        TextTrimming="WordEllipsis"
                                        TextWrapping="NoWrap" />
                                    <HyperlinkButton Command="{x:Bind ViewModel.OpenAudioFolderCommand, Mode=OneWay}">
                                        <TextBlock
                                            MaxLines="2"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.AudioFolderPath, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </HyperlinkButton>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button Command="{x:Bind ViewModel.ChangeAudioFolderCommand, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Viewbox Height="16">
                                                <SymbolIcon Symbol="Folder" />
                                            </Viewbox>
                                            <TextBlock x:Uid="Settings_AudioAutoSave_ChangeButton" Text="Change" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Expander>
                    </StackPanel>

                    <!--  Video Capture section  -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Settings_VideoCaptureHeaderLabel" Margin="0,4" />

                        <!--  Default Local Audio  -->
                        <Grid
                            Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefault}"
                            BorderBrush="{ThemeResource CardStrokeColorDefault}"
                            BorderThickness="1"
                            ColumnSpacing="16"
                            CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>

                            <SymbolIcon Symbol="Volume" />

                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    x:Uid="Settings_VideoDefaultLocalAudio_HeaderLabel"
                                    MaxLines="2"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Uid="Settings_VideoDefaultLocalAudio_SubtitleLabel"
                                    FontSize="12"
                                    MaxLines="2"
                                    Opacity=".75"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <ToggleSwitch
                                x:Uid="Settings_VideoDefaultLocalAudio_Toggle"
                                Grid.Column="2"
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                IsOn="{x:Bind ViewModel.VideoCaptureDefaultLocalAudio, Mode=OneWay}"
                                Toggled="VideoDefaultLocalAudioToggleSwitch_Toggled" />
                        </Grid>

                        <!--  Auto copy  -->
                        <Grid
                            Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefault}"
                            BorderBrush="{ThemeResource CardStrokeColorDefault}"
                            BorderThickness="1"
                            ColumnSpacing="16"
                            CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>

                            <SymbolIcon Symbol="Copy" />

                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    x:Uid="Settings_VideoAutoCopy_HeaderLabel"
                                    MaxLines="2"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Uid="Settings_VideoAutoCopy_SubtitleLabel"
                                    FontSize="12"
                                    MaxLines="2"
                                    Opacity=".75"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <ToggleSwitch
                                x:Uid="Settings_VideoAutoCopy_Toggle"
                                Grid.Column="2"
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                IsOn="{x:Bind ViewModel.VideoCaptureAutoCopy, Mode=OneWay}"
                                Toggled="VideoAutoCopyToggleSwitch_Toggled" />
                        </Grid>

                        <!--  Auto save  -->
                        <Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="True">
                            <Expander.Header>
                                <Grid
                                    Padding="0,12"
                                    ColumnSpacing="16"
                                    CornerRadius="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <SymbolIcon Symbol="Save" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            x:Uid="Settings_VideoAutoSave_HeaderLabel"
                                            MaxLines="2"
                                            TextTrimming="WordEllipsis"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            x:Uid="Settings_VideoAutoSave_SubtitleLabel"
                                            FontSize="12"
                                            MaxLines="2"
                                            Opacity=".75"
                                            TextTrimming="WordEllipsis"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>

                                    <ToggleSwitch
                                        x:Uid="Settings_VideoAutoSave_Toggle"
                                        Grid.Column="2"
                                        MinWidth="0"
                                        HorizontalAlignment="Right"
                                        IsOn="{x:Bind ViewModel.VideoCaptureAutoSave, Mode=OneWay}"
                                        Toggled="VideoAutoSaveToggleSwitch_Toggled" />
                                </Grid>
                            </Expander.Header>
                            <Grid Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        x:Uid="Settings_VideoAutoSave_VideosFolderLabel"
                                        MaxLines="2"
                                        TextTrimming="WordEllipsis"
                                        TextWrapping="NoWrap" />
                                    <HyperlinkButton Command="{x:Bind ViewModel.OpenVideosFolderCommand, Mode=OneWay}">
                                        <TextBlock
                                            MaxLines="2"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.VideosFolderPath, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </HyperlinkButton>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button Command="{x:Bind ViewModel.ChangeVideosFolderCommand, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Viewbox Height="16">
                                                <SymbolIcon Symbol="Folder" />
                                            </Viewbox>
                                            <TextBlock x:Uid="Settings_VideoAutoSave_ChangeButton" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Expander>
                    </StackPanel>

                    <!--  Capture section  -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Settings_CaptureHeaderLabel" Margin="0,4" />

                        <Grid
                            Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefault}"
                            BorderBrush="{ThemeResource CardStrokeColorDefault}"
                            BorderThickness="1"
                            ColumnSpacing="16"
                            CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>

                            <SymbolIcon Symbol="Important" />

                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    x:Uid="Settings_CaptureWarnBeforeDiscard_HeaderLabel"
                                    MaxLines="2"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Uid="Settings_CaptureWarnBeforeDiscard_SubtitleLabel"
                                    FontSize="12"
                                    MaxLines="2"
                                    Opacity=".75"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <ToggleSwitch
                                x:Uid="Settings_CaptureWarnBeforeDiscard_Toggle"
                                Grid.Column="2"
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                IsOn="{x:Bind ViewModel.CaptureWarnBeforeDiscard, Mode=OneWay}"
                                Toggled="CaptureWarnBeforeDiscardToggleSwitch_Toggled" />
                        </Grid>
                    </StackPanel>

                    <!--  Edit section  -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Settings_EditHeaderLabel" Margin="0,4" />

                        <Grid
                            Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefault}"
                            BorderBrush="{ThemeResource CardStrokeColorDefault}"
                            BorderThickness="1"
                            ColumnSpacing="16"
                            CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>

                            <SymbolIcon Symbol="Important" />

                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    x:Uid="Settings_EditWarnBeforeDiscard_HeaderLabel"
                                    MaxLines="2"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Uid="Settings_EditWarnBeforeDiscard_SubtitleLabel"
                                    FontSize="12"
                                    MaxLines="2"
                                    Opacity=".75"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <ToggleSwitch
                                x:Uid="Settings_EditWarnBeforeDiscard_Toggle"
                                Grid.Column="2"
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                IsOn="{x:Bind ViewModel.EditWarnBeforeDiscard, Mode=OneWay}"
                                Toggled="EditWarnBeforeDiscardToggleSwitch_Toggled" />
                        </Grid>

                    </StackPanel>

                    <!--  Store section  -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Settings_StoreHeaderLabel" Margin="0,4" />

                        <Grid
                            Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefault}"
                            BorderBrush="{ThemeResource CardStrokeColorDefault}"
                            BorderThickness="1"
                            ColumnSpacing="16"
                            CornerRadius="4"
                            RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <SymbolIcon Grid.RowSpan="2" Symbol="Favorite" />

                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    x:Uid="Settings_StoreReview_HeaderLabel"
                                    MaxLines="2"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Uid="Settings_StoreReview_SubtitleLabel"
                                    FontSize="12"
                                    MaxLines="2"
                                    Opacity=".75"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <ToggleSwitch
                                x:Uid="Settings_StoreReviewReminders_Toggle"
                                Grid.Column="2"
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                IsOn="{x:Bind ViewModel.StoreReviewRemindersEnabled, Mode=OneWay}"
                                Toggled="StoreReviewRemindersToggleSwitch_Toggled" />

                            <HyperlinkButton
                                Grid.Row="1"
                                Grid.Column="1"
                                Padding="0"
                                Command="{x:Bind ViewModel.OpenStoreReviewCommand, Mode=OneWay}">
                                <TextBlock x:Uid="Settings_StoreReview_LinkLabel" TextWrapping="WrapWholeWords" />
                            </HyperlinkButton>
                        </Grid>
                    </StackPanel>

                    <!--  Capture Memory section  -->
                    <StackPanel
                        Spacing="4"
                        Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.CaptureMemory.IsVisible), Mode=OneWay}">
                        <TextBlock x:Uid="CaptureMemory_Settings_Header" Margin="0,4" />

                        <Grid
                            Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefault}"
                            BorderBrush="{ThemeResource CardStrokeColorDefault}"
                            BorderThickness="1"
                            ColumnSpacing="16"
                            CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <SymbolIcon Symbol="Find" />

                            <StackPanel Grid.Column="1" Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="CaptureMemory_Settings_AnalysisTitle"
                                        FontWeight="SemiBold"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        x:Uid="CaptureMemory_Settings_AnalysisDescription"
                                        FontSize="12"
                                        Opacity=".75"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="Settings_CaptureMemoryPolicyStatus"
                                        AutomationProperties.LiveSetting="Polite"
                                        Text="{x:Bind ViewModel.CaptureMemory.PolicyStatusText, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.CaptureMemory.ShowAuthorizedControls), Mode=OneWay}">
                                    <ToggleSwitch
                                        x:Uid="CaptureMemory_Settings_AnalyzeNewToggle"
                                        AutomationProperties.AutomationId="Settings_CaptureMemoryAnalyzeNewToggle"
                                        IsEnabled="{x:Bind ViewModel.CaptureMemory.CanChangeAnalysisState, Mode=OneWay}"
                                        IsOn="{x:Bind ViewModel.CaptureMemory.IsAnalyzingNewCaptures, Mode=OneWay}"
                                        Toggled="CaptureMemoryAnalysisToggleSwitch_Toggled" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid
                            Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefault}"
                            BorderBrush="{ThemeResource CardStrokeColorDefault}"
                            BorderThickness="1"
                            ColumnSpacing="16"
                            CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <SymbolIcon Symbol="Manage" />

                            <StackPanel Grid.Column="1" Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="CaptureMemory_Settings_DataTitle"
                                        FontWeight="SemiBold"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        x:Uid="CaptureMemory_Settings_DataDescription"
                                        FontSize="12"
                                        Opacity=".75"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Uid="CaptureMemory_Settings_ClearTitle" />
                                        <TextBlock
                                            x:Uid="CaptureMemory_Settings_ClearDescription"
                                            FontSize="12"
                                            Opacity=".75"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <Button
                                        x:Uid="CaptureMemory_Settings_ClearButton"
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="Settings_CaptureMemoryClearButton"
                                        Command="{x:Bind ViewModel.CaptureMemory.ClearMemoryCommand, Mode=OneWay}" />
                                </Grid>

                                <Grid
                                    ColumnSpacing="12"
                                    Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.CaptureMemory.ShowAuthorizedControls), Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Uid="CaptureMemory_Settings_TurnOffTitle" />
                                        <TextBlock
                                            x:Uid="CaptureMemory_Settings_TurnOffDescription"
                                            FontSize="12"
                                            Opacity=".75"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <Button
                                        x:Uid="CaptureMemory_Settings_TurnOffButton"
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="Settings_CaptureMemoryTurnOffButton"
                                        Command="{x:Bind ViewModel.CaptureMemory.TurnOffAndEraseCommand, Mode=OneWay}" />
                                </Grid>

                                <Expander
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.AutomationId="Settings_CaptureMemoryTroubleshootingExpander"
                                    AutomationProperties.LabeledBy="{x:Bind CaptureMemoryTroubleshootingHeaderTextBlock}"
                                    ExpandDirection="Down">
                                    <Expander.Header>
                                        <Grid Padding="0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>

                                            <SymbolIcon Symbol="Repair" />

                                            <StackPanel Grid.Column="1" Padding="16,0,0,0">
                                                <TextBlock
                                                    x:Name="CaptureMemoryTroubleshootingHeaderTextBlock"
                                                    x:Uid="CaptureMemory_Settings_TroubleshootingTitle"
                                                    TextTrimming="WordEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <TextBlock
                                                    x:Uid="CaptureMemory_Settings_TroubleshootingSubtitle"
                                                    FontSize="12"
                                                    Opacity=".75"
                                                    TextTrimming="WordEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Margin="4,0" Padding="0,0,0,8" Spacing="12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Uid="CaptureMemory_Settings_RebuildTitle" />
                                                <TextBlock
                                                    x:Uid="CaptureMemory_Settings_RebuildDescription"
                                                    FontSize="12"
                                                    Opacity=".75"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                            <Button
                                                x:Uid="CaptureMemory_Settings_RebuildButton"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="Settings_CaptureMemoryRebuildButton"
                                                Command="{x:Bind ViewModel.CaptureMemory.RebuildSearchIndexCommand, Mode=OneWay}" />
                                        </Grid>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Uid="CaptureMemory_Settings_ReanalyzeTitle" />
                                                <TextBlock
                                                    x:Uid="CaptureMemory_Settings_ReanalyzeDescription"
                                                    FontSize="12"
                                                    Opacity=".75"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                            <Button
                                                x:Uid="CaptureMemory_Settings_ReanalyzeButton"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="Settings_CaptureMemoryReanalyzeButton"
                                                Command="{x:Bind ViewModel.CaptureMemory.ReanalyzeCapturesCommand, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <StackPanel
                                    Spacing="6"
                                    Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.CaptureMemory.ShowProgress), Mode=OneWay}">
                                    <ProgressBar
                                        AutomationProperties.AutomationId="Settings_CaptureMemoryOperationProgress"
                                        Maximum="1"
                                        Value="{x:Bind ViewModel.CaptureMemory.OperationProgress, Mode=OneWay}" />
                                    <Button
                                        x:Uid="CaptureMemory_Settings_CancelButton"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.AutomationId="Settings_CaptureMemoryCancelButton"
                                        Command="{x:Bind ViewModel.CaptureMemory.CancelOperationCommand, Mode=OneWay}" />
                                </StackPanel>

                                <TextBlock
                                    AutomationProperties.AutomationId="Settings_CaptureMemoryOperationStatus"
                                    AutomationProperties.LiveSetting="Polite"
                                    Text="{x:Bind ViewModel.CaptureMemory.OperationStatusText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords"
                                    Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.CaptureMemory.HasOperationStatus), Mode=OneWay}" />
                                <InfoBar
                                    x:Uid="CaptureMemory_Settings_Failure"
                                    IsClosable="False"
                                    IsOpen="{x:Bind ViewModel.CaptureMemory.HasOperationFailure, Mode=OneWay}"
                                    Message="{x:Bind ViewModel.CaptureMemory.OperationStatusText, Mode=OneWay}"
                                    Severity="Error" />
                                <InfoBar
                                    x:Uid="CaptureMemory_Settings_Recovery"
                                    IsClosable="False"
                                    IsOpen="{x:Bind ViewModel.CaptureMemory.NeedsRecovery, Mode=OneWay}"
                                    Message="{x:Bind ViewModel.CaptureMemory.OperationStatusText, Mode=OneWay}"
                                    Severity="Warning" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!--  Downloaded AI model storage section  -->
                    <StackPanel
                        Spacing="4"
                        Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsAiModelStorageVisible), Mode=OneWay}">
                        <TextBlock x:Uid="Settings_AiModelStorage_Header" Margin="0,4" />

                        <Grid
                            Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefault}"
                            BorderBrush="{ThemeResource CardStrokeColorDefault}"
                            BorderThickness="1"
                            ColumnSpacing="16"
                            CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <SymbolIcon Symbol="Download" />

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock
                                    x:Uid="Settings_AiModelStorage_Title"
                                    FontWeight="SemiBold"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Uid="Settings_AiModelStorage_Description"
                                    FontSize="12"
                                    Opacity=".75"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    AutomationProperties.AutomationId="Settings_AiModelStorageSummary"
                                    Text="{x:Bind ViewModel.AiModelStorageSummaryText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    AutomationProperties.AutomationId="Settings_AiModelStorageStatus"
                                    AutomationProperties.LiveSetting="Polite"
                                    Text="{x:Bind ViewModel.AiModelStorageStatusText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords"
                                    Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasAiModelStorageStatus), Mode=OneWay}" />
                            </StackPanel>

                            <Button
                                x:Uid="Settings_AiModelStorage_RemoveButton"
                                Grid.Column="2"
                                AutomationProperties.AutomationId="Settings_RemoveDownloadedAiModelsButton"
                                Command="{x:Bind ViewModel.RemoveDownloadedAiModelsCommand, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>

                    <!--  AI consent section  -->
                    <StackPanel Spacing="4" Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsAiConsentSettingsVisible), Mode=OneWay}">
                        <TextBlock x:Uid="Settings_AiConsentHeaderLabel" Margin="0,4" />
                        <TextBlock
                            x:Uid="Settings_AiConsentSectionDescription"
                            Margin="0,0,0,4"
                            FontSize="12"
                            Opacity=".75"
                            TextWrapping="WrapWholeWords" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.AiFeatureConsents, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="settings:AiFeatureConsentViewModel">
                                    <Grid
                                        Padding="16,12"
                                        Background="{ThemeResource CardBackgroundFillColorDefault}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefault}"
                                        BorderThickness="1"
                                        ColumnSpacing="16"
                                        CornerRadius="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>

                                        <SymbolIcon Symbol="Permissions" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock
                                                MaxLines="2"
                                                Text="{x:Bind DisplayName}"
                                                TextTrimming="WordEllipsis"
                                                TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            FontSize="12"
                                            MaxLines="2"
                                            Opacity=".75"
                                            Text="{x:Bind Description}"
                                            TextTrimming="WordEllipsis"
                                            TextWrapping="WrapWholeWords" />
                                        </StackPanel>

                                        <CheckBox
                                            Grid.Column="2"
                                            MinWidth="0"
                                            HorizontalAlignment="Right"
                                            AutomationProperties.Name="{x:Bind DisplayName}"
                                            Click="AiFeatureConsentCheckBox_Click"
                                            IsChecked="{x:Bind IsConsented, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!--  Privacy section  -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Settings_PrivacyHeaderLabel" Margin="0,4" />

                        <Grid
                            Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefault}"
                            BorderBrush="{ThemeResource CardStrokeColorDefault}"
                            BorderThickness="1"
                            ColumnSpacing="16"
                            CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>

                            <SymbolIcon Symbol="Permissions" />

                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    x:Uid="Settings_OptionalUsageData_HeaderLabel"
                                    MaxLines="2"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Uid="Settings_OptionalUsageData_SubtitleLabel"
                                    FontSize="12"
                                    Opacity=".75"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <ToggleSwitch
                                x:Name="OptionalUsageDataToggleSwitch"
                                x:Uid="Settings_OptionalUsageData_Toggle"
                                Grid.Column="2"
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                AutomationProperties.AutomationId="OptionalUsageDataToggleSwitch"
                                IsOn="{x:Bind ViewModel.OptionalUsageDataEnabled, Mode=OneWay}"
                                Toggled="OptionalUsageDataToggleSwitch_Toggled" />
                        </Grid>
                    </StackPanel>

                    <!--  Appearance section  -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Settings_AppearanceHeaderLabel" Margin="0,4" />
                        <!--  App theme  -->
                        <Expander
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.LabeledBy="{x:Bind AppThemeHeaderTextBlock}"
                            ExpandDirection="Down"
                            IsExpanded="True">
                            <Expander.Header>
                                <Grid Padding="0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        FontFamily="{StaticResource FluentSystemIcons}"
                                        FontSize="24"
                                        Glyph="{StaticResource Color16Regular}" />
                                    <StackPanel Grid.Column="1" Padding="16,0,0,0">
                                        <TextBlock
                                            x:Name="AppThemeHeaderTextBlock"
                                            x:Uid="Settings_AppThemeHeaderLabel"
                                            TextTrimming="WordEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            x:Uid="Settings_AppThemeSubtitleLabel"
                                            FontSize="12"
                                            Opacity=".8"
                                            TextTrimming="WordEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <Grid Margin="4,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <RadioButtons
                                    ItemsSource="{x:Bind ViewModel.AppThemes, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.SelectedAppThemeIndex, Mode=OneWay}"
                                    SelectionChanged="AppThemeRadioButtons_SelectionChanged">
                                    <RadioButtons.ItemTemplate>
                                        <DataTemplate x:DataType="settings:AppThemeViewModel">
                                            <RadioButton AutomationProperties.Name="{x:Bind AutomationName}">
                                                <TextBlock
                                                    Margin="12,0,0,0"
                                                    Text="{x:Bind DisplayName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </RadioButton>
                                        </DataTemplate>
                                    </RadioButtons.ItemTemplate>
                                </RadioButtons>
                                <Grid
                                    Margin="0,12,0,0"
                                    Padding="0,12,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    BorderBrush="{ThemeResource SystemBaseLowColor}"
                                    BorderThickness="0,1,0,0"
                                    ColumnSpacing="12"
                                    Row="1"
                                    Visibility="{x:Bind ViewModel.ShowAppThemeRestartMessage, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Uid="Settings_RestartAppButton"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.RestartAppCommand, Mode=OneWay}">
                                        <TextBlock x:Uid="Settings_RestartAppButtonLabel" />
                                    </Button>
                                    <TextBlock
                                        x:Uid="Settings_FullChangesWillTakeAffectLabel"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Opacity=".8"
                                        TextAlignment="Center"
                                        TextTrimming="WordEllipsis"
                                        TextWrapping="NoWrap" />
                                </Grid>
                            </Grid>
                        </Expander>
                    </StackPanel>

                    <!--  Localization section  -->
                    <StackPanel
                        x:Name="LocalizationSection"
                        Spacing="4"
                        Visibility="Collapsed">
                        <TextBlock x:Uid="Settings_LocalizationHeaderLabel" Margin="0,4" />
                        <!--  App language  -->
                        <Expander
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.LabeledBy="{x:Bind AppLangaugeHeaderTextBlock}"
                            ExpandDirection="Down"
                            IsExpanded="True">
                            <Expander.Header>
                                <Grid Padding="0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        FontFamily="{StaticResource FluentSystemIcons}"
                                        FontSize="24"
                                        Glyph="{StaticResource LocalLanguage24Regular}" />
                                    <StackPanel Grid.Column="1" Padding="16,0,0,0">
                                        <TextBlock
                                            x:Name="AppLangaugeHeaderTextBlock"
                                            x:Uid="Settings_AppLanguageHeaderLabel"
                                            TextTrimming="WordEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            x:Uid="Settings_AppLanguageSubtitleLabel"
                                            FontSize="12"
                                            Opacity=".75"
                                            TextTrimming="WordEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <Grid Margin="4,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <RadioButtons
                                    ItemsSource="{x:Bind ViewModel.AppLanguages, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.SelectedAppLanguageIndex, Mode=OneWay}"
                                    SelectionChanged="AppLanguageRadioButtons_SelectionChanged">
                                    <RadioButtons.ItemTemplate>
                                        <DataTemplate x:DataType="settings:AppLanguageViewModel">
                                            <RadioButton AutomationProperties.Name="{x:Bind AutomationName}">
                                                <TextBlock
                                                    Margin="12,0,0,0"
                                                    Text="{x:Bind DisplayName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </RadioButton>
                                        </DataTemplate>
                                    </RadioButtons.ItemTemplate>
                                </RadioButtons>
                                <Grid
                                    Margin="0,12,0,0"
                                    Padding="0,12,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    BorderBrush="{ThemeResource SystemBaseLowColor}"
                                    BorderThickness="0,1,0,0"
                                    ColumnSpacing="12"
                                    Row="1"
                                    Visibility="{x:Bind ViewModel.ShowAppLanguageRestartMessage, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Uid="Settings_RestartAppButton"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.RestartAppCommand, Mode=OneWay}">
                                        <TextBlock x:Uid="Settings_RestartAppButtonLabel" />
                                    </Button>
                                    <TextBlock
                                        x:Uid="Settings_FullChangesWillTakeAffectLabel"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Opacity=".8"
                                        TextAlignment="Center"
                                        TextTrimming="WordEllipsis"
                                        TextWrapping="NoWrap" />
                                </Grid>
                            </Grid>
                        </Expander>
                    </StackPanel>

                    <!--  Other section  -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Settings_OtherHeaderLabel" Margin="0,4" />

                        <!--  Temporary files  -->
                        <Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="True">
                            <Expander.Header>
                                <Grid
                                    Padding="0,12"
                                    ColumnSpacing="16"
                                    CornerRadius="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <SymbolIcon Symbol="Folder" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            x:Uid="Settings_TemporaryFolder_HeaderLabel"
                                            MaxLines="2"
                                            TextTrimming="WordEllipsis"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            x:Uid="Settings_TemporaryFolder_SubtitleLabel"
                                            FontSize="12"
                                            MaxLines="2"
                                            Opacity=".75"
                                            TextTrimming="WordEllipsis"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <Grid Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        x:Uid="Settings_TemporaryFolder_ScreenshotsFolderLabel"
                                        MaxLines="2"
                                        TextTrimming="WordEllipsis"
                                        TextWrapping="NoWrap" />
                                    <HyperlinkButton Command="{x:Bind ViewModel.OpenTemporaryFilesFolderCommand, Mode=OneWay}">
                                        <TextBlock
                                            MaxLines="2"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.TemporaryFilesFolderPath, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </HyperlinkButton>
                                    <TextBlock
                                        AutomationProperties.LiveSetting="Polite"
                                        FontSize="12"
                                        Opacity=".75"
                                        Text="{x:Bind ViewModel.TemporaryFilesStatusText, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords"
                                        Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasTemporaryFilesStatus), Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button Command="{x:Bind ViewModel.ClearTemporaryFilesCommand, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Viewbox Height="16">
                                                <SymbolIcon Symbol="Delete" />
                                            </Viewbox>
                                            <TextBlock x:Uid="Settings_TemporaryFolder_ClearButton" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Expander>
                    </StackPanel>

                    <!--  Restore defaults  -->
                    <Button Command="{x:Bind ViewModel.RestoreDefaultSettingsCommand, Mode=OneWay}">
                        <TextBlock x:Uid="Settings_RestoreDefaults_Button" />
                        <ToolTipService.ToolTip>
                            <ToolTip>
                                <TextBlock x:Uid="Settings_RestoreDefaults_ToolTip" />
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>

                </StackPanel>
            </StackPanel>
        </ScrollView>
    </Grid>
</local:SettingsPageBase>
