<?xml version="1.0" encoding="utf-8" ?>
<local:ImageEditPageBase
    x:Class="CaptureTool.Presentation.Windows.WinUI.Xaml.Pages.ImageEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CaptureTool.Presentation.Windows.WinUI.Xaml.Controls"
    xmlns:converters="using:CaptureTool.Presentation.Windows.WinUI.Xaml.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:imageedit="using:CaptureTool.Presentation.Features.ImageEdit"
    xmlns:local="using:CaptureTool.Presentation.Windows.WinUI.Xaml.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="using:CaptureTool.Presentation.Windows.WinUI.Utils"
    d:DataContext="{d:DesignInstance Type=imageedit:ImageEditPageViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:ShapeTypeToIntConverter x:Key="ShapeTypeToIntConverter" />
    </Page.Resources>

    <Grid
        AutomationProperties.AccessibilityView="Control"
        AutomationProperties.AutomationId="ImageEditPageRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <CommandBar
            AutomationProperties.AutomationId="ImageEdit_CommandBar"
            HorizontalAlignment="Stretch"
            DefaultLabelPosition="Right"
            IsOpen="False">
            <!--  Chroma Key  -->
            <AppBarToggleButton
                x:Uid="ImageEdit_ChromaKeyButton"
                Checked="ChromaKeyAppBarToggleButton_IsCheckedChanged"
                IsChecked="{x:Bind ViewModel.IsChromaKeyModeActive, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}"
                Unchecked="ChromaKeyAppBarToggleButton_IsCheckedChanged"
                Visibility="{x:Bind ViewModel.ChromaKeyTool.IsChromaKeyAddOnOwned, Mode=OneWay}">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="{StaticResource Color}" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarSeparator Visibility="{x:Bind ViewModel.ChromaKeyTool.IsChromaKeyAddOnOwned, Mode=OneWay}" />
            <AppBarToggleButton
                x:Uid="ImageEdit_SuperResolutionButton"
                AutomationProperties.AutomationId="ImageEdit_SuperResolutionButton"
                Command="{x:Bind ViewModel.ToggleSuperResolutionCommand}"
                IsChecked="{x:Bind ViewModel.IsSuperResolutionActive, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanToggleSuperResolution, Mode=OneWay}"
                Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsSuperResolutionAvailable), Mode=OneWay}">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE945;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton
                x:Uid="ImageEdit_TextExtractionButton"
                AutomationProperties.AutomationId="ImageEdit_TextExtractionButton"
                Command="{x:Bind ViewModel.ToggleTextExtractionModeCommand}"
                IsChecked="{x:Bind ViewModel.IsTextExtractionModeActive, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanToggleTextExtraction, Mode=OneWay}"
                Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsTextExtractionAvailable), Mode=OneWay}">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE8D2;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton
                x:Uid="ImageEdit_ImageDescriptionButton"
                AutomationProperties.AutomationId="ImageEdit_ImageDescriptionButton"
                Command="{x:Bind ViewModel.ToggleImageDescriptionModeCommand}"
                IsChecked="{x:Bind ViewModel.IsImageDescriptionModeActive, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanToggleImageDescription, Mode=OneWay}"
                Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsImageDescriptionAvailable), Mode=OneWay}">
                <AppBarToggleButton.Icon>
                    <SymbolIcon Symbol="Comment" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton
                x:Uid="ImageEdit_ForegroundExtractionButton"
                AutomationProperties.AutomationId="ImageEdit_ForegroundExtractionButton"
                Command="{x:Bind ViewModel.ToggleForegroundExtractionModeCommand}"
                IsChecked="{x:Bind ViewModel.IsForegroundExtractionModeActive, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanToggleForegroundExtraction, Mode=OneWay}"
                Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsForegroundExtractionAvailable), Mode=OneWay}">
                <AppBarToggleButton.Icon>
                    <SymbolIcon Symbol="Cut" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton
                x:Uid="ImageEdit_ObjectEraseButton"
                AutomationProperties.AutomationId="ImageEdit_ObjectEraseButton"
                Command="{x:Bind ViewModel.ToggleObjectEraseModeCommand}"
                IsChecked="{x:Bind ViewModel.IsObjectEraseModeActive, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanToggleObjectErase, Mode=OneWay}"
                Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsObjectEraseAvailable), Mode=OneWay}">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton
                x:Uid="ImageEdit_ObjectExtractionButton"
                AutomationProperties.AutomationId="ImageEdit_ObjectExtractionButton"
                Command="{x:Bind ViewModel.ToggleObjectExtractionModeCommand}"
                IsChecked="{x:Bind ViewModel.IsObjectExtractionModeActive, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanToggleObjectExtraction, Mode=OneWay}"
                Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsObjectExtractionAvailable), Mode=OneWay}">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE8B7;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton
                x:Uid="ImageEdit_ColorPickerButton"
                Command="{x:Bind ViewModel.ToggleColorPickerModeCommand}"
                IsChecked="{x:Bind ViewModel.IsColorPickerModeActive, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="{StaticResource Color}" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <!--  Crop and orientation  -->
            <AppBarToggleButton
                x:Uid="ImageEdit_CropButton"
                Command="{x:Bind ViewModel.ToggleCropModeCommand}"
                Icon="Crop"
                IsChecked="{x:Bind ViewModel.IsCropModeActive, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}" />
            <AppBarToggleButton
                x:Uid="ImageEdit_ShapesButton"
                Command="{x:Bind ViewModel.ToggleShapesModeCommand}"
                IsChecked="{x:Bind ViewModel.IsShapesModeActive, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE91B;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton
                x:Uid="ImageEdit_TextButton"
                Command="{x:Bind ViewModel.ToggleTextModeCommand}"
                IsChecked="{x:Bind ViewModel.IsTextModeActive, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE8D2;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarSeparator />
            <AppBarButton
                x:Uid="ImageEdit_RotateButton"
                Command="{x:Bind ViewModel.RotateCommand}"
                Icon="Rotate"
                IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}" />
            <AppBarButton
                x:Uid="ImageEdit_FlipXButton"
                Command="{x:Bind ViewModel.FlipHorizontalCommand}"
                IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon
                        FontFamily="{StaticResource FluentSystemIcons}"
                        FontSize="32"
                        Glyph="{StaticResource FlipHorizontal32Regular}" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                x:Uid="ImageEdit_FlipYButton"
                Command="{x:Bind ViewModel.FlipVerticalCommand}"
                IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon
                        FontFamily="{StaticResource FluentSystemIcons}"
                        FontSize="32"
                        Glyph="{StaticResource FlipVertical32Regular}" />
                </AppBarButton.Icon>
            </AppBarButton>
            <!--  Undo/Redo  -->
            <AppBarSeparator />
            <AppBarButton
                x:Uid="ImageEdit_UndoButton"
                Command="{x:Bind ViewModel.UndoCommand}"
                Icon="Undo"
                IsEnabled="{x:Bind ViewModel.HasUndoStack, Mode=OneWay}" />
            <AppBarButton
                x:Uid="ImageEdit_RedoButton"
                Command="{x:Bind ViewModel.RedoCommand}"
                Icon="Redo"
                IsEnabled="{x:Bind ViewModel.HasRedoStack, Mode=OneWay}" />
            <!--  Export  -->
            <AppBarSeparator />
            <!--  Copy  -->
            <AppBarButton
                x:Uid="ImageEdit_CopyButton"
                Command="{x:Bind ViewModel.CopyCommand}"
                Icon="Copy"
                IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="C" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <!--  Save  -->
            <AppBarButton
                x:Uid="ImageEdit_SaveButton"
                Command="{x:Bind ViewModel.SaveCommand}"
                Icon="Save"
                IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                <AppBarButton.Label>Save as</AppBarButton.Label>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <!--  Open screenshots folder  -->
            <AppBarButton
                x:Uid="ImageEdit_OpenScreenshotsFolderButton"
                Command="{x:Bind ViewModel.OpenScreenshotsFolderCommand}"
                Icon="Folder" />
            <!--  Print  -->
            <AppBarButton
                x:Uid="ImageEdit_PrintButton"
                Command="{x:Bind ViewModel.PrintCommand}"
                Icon="Print"
                IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="P" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <!--  Share  -->
            <AppBarButton
                x:Uid="ImageEdit_ShareButton"
                Command="{x:Bind ViewModel.ShareCommand}"
                Icon="Share"
                IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}" />
            <!--  Edit in Paint  -->
            <AppBarButton
                x:Uid="ImageEdit_EditInPaintButton"
                Command="{x:Bind ViewModel.EditInPaintCommand}"
                Icon="Edit"
                IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                <AppBarButton.Label>Edit in Paint</AppBarButton.Label>
            </AppBarButton>
        </CommandBar>

        <!--  Canvas  -->
        <Grid
            x:Name="CanvasContainer"
            Background="{ThemeResource ImageEditCanvasBackgroundBrush}"
            BorderBrush="{ThemeResource SystemControlBackgroundBaseLowBrush}"
            BorderThickness="0,1"
            Row="2">
            <controls:ImageCanvas
                x:Name="ImageCanvas"
                AutomationProperties.AccessibilityView="Control"
                AutomationProperties.AutomationId="ImageEdit_ImageCanvas"
                CanvasSize="{x:Bind ViewModel.ImageSize, Mode=OneWay}"
                ColorPickerColorHovered="ImageCanvas_ColorPickerColorHovered"
                ColorPickerColorPicked="ImageCanvas_ColorPickerColorPicked"
                CropRect="{x:Bind ViewModel.CropRect, Mode=OneWay}"
                CropRectChanged="ImageCanvas_CropRectChanged"
                Drawables="{x:Bind ViewModel.Drawables, Mode=OneWay}"
                ForegroundExtractionRequested="ImageCanvas_ForegroundExtractionRequested"
                ObjectEraseRequested="ImageCanvas_ObjectEraseRequested"
                ObjectExtractionRequested="ImageCanvas_ObjectExtractionRequested"
                InteractionComplete="ImageCanvas_InteractionComplete"
                IsAutoZoomLocked="{x:Bind ViewModel.IsAutoZoomLocked, Mode=OneWay}"
                IsColorPickerModeEnabled="{x:Bind ViewModel.IsColorPickerModeActive, Mode=OneWay}"
                IsCropModeEnabled="{x:Bind ViewModel.IsCropModeActive, Mode=OneWay}"
                IsForegroundExtractionModeEnabled="{x:Bind ViewModel.IsForegroundExtractionModeActive, Mode=OneWay}"
                IsObjectEraseModeEnabled="{x:Bind ViewModel.IsObjectEraseModeActive, Mode=OneWay}"
                IsObjectExtractionModeEnabled="{x:Bind ViewModel.IsObjectExtractionModeActive, Mode=OneWay}"
                IsShapesModeEnabled="{x:Bind ViewModel.IsShapesModeActive, Mode=OneWay}"
                IsTextModeEnabled="{x:Bind ViewModel.IsTextModeActive, Mode=OneWay}"
                IsTextExtractionOverlayEnabled="{x:Bind ViewModel.IsTextExtractionModeActive, Mode=OneWay}"
                Orientation="{x:Bind ViewModel.Orientation, Mode=OneWay}"
                SelectedShapeType="{x:Bind ViewModel.ShapeTool.SelectedShapeType, Mode=OneWay}"
                ShapeDeleted="ImageCanvas_ShapeDeleted"
                ShapeDrawableSelected="ImageCanvas_ShapeDrawableSelected"
                ShapeDrawn="ImageCanvas_ShapeDrawn"
                ShapeFillColor="{x:Bind ViewModel.ShapeTool.ShapeFillColor, Mode=OneWay}"
                ShapeModified="ImageCanvas_ShapeModified"
                ShapeStrokeColor="{x:Bind ViewModel.ShapeTool.ShapeStrokeColor, Mode=OneWay}"
                ShapeStrokeWidth="{x:Bind ViewModel.ShapeTool.ShapeStrokeWidth, Mode=OneWay}"
                TextBackgroundColor="{x:Bind ViewModel.TextTool.TextBackgroundColor, Mode=OneWay}"
                TextBoxDrawn="ImageCanvas_TextBoxDrawn"
                TextExtractionRegions="{x:Bind ViewModel.TextExtractionRegions, Mode=OneWay}"
                TextDrawableSelected="ImageCanvas_TextDrawableSelected"
                TextFontFamily="{x:Bind ViewModel.TextTool.TextFontFamily, Mode=OneWay}"
                TextFontSize="{x:Bind ViewModel.TextTool.TextFontSize, Mode=OneWay}"
                TextForegroundColor="{x:Bind ViewModel.TextTool.TextFontColor, Mode=OneWay}" />

            <Button
                x:Uid="ImageEdit_TextExtractionOverlayMarker"
                Width="16"
                Height="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Control"
                AutomationProperties.AutomationId="ImageEdit_TextExtractionOverlayMarker"
                Background="Transparent"
                IsEnabled="False"
                IsTabStop="False"
                Opacity=".01"
                Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasTextExtractionRegions), Mode=OneWay}" />

            <Grid
                x:Name="FloatingToolbarLayer"
                Margin="12,8,12,0"
                HorizontalAlignment="stretch"
                VerticalAlignment="Top">
                <!--  Chroma key options  -->
                <controls:ChromaKeyToolbar
                    x:Name="ChromaKeyToolbarHost"
                    HorizontalAlignment="Center"
                    ChromaKeyInteractionCompleted="ChromaKeyToolbar_ChromaKeyInteractionCompleted"
                    ChromaKeyInteractionStarted="ChromaKeyToolbar_ChromaKeyInteractionStarted"
                    ColorOptions="{x:Bind ViewModel.ChromaKeyTool.ChromaKeyColorOptions, Mode=OneWay}"
                    Desaturation="{x:Bind ViewModel.ChromaKeyTool.ChromaKeyDesaturation, Mode=OneWay}"
                    DesaturationChanged="ChromaKeyToolbar_DesaturationChanged"
                    Opacity="0"
                    SelectedColorOptionIndex="{x:Bind ViewModel.ChromaKeyTool.SelectedChromaKeyColorOption, Mode=OneWay}"
                    SelectedColorOptionIndexChanged="ChromaKeyToolbar_SelectedColorOptionIndexChanged"
                    Tolerance="{x:Bind ViewModel.ChromaKeyTool.ChromaKeyTolerance, Mode=OneWay}"
                    ToleranceChanged="ChromaKeyToolbar_ToleranceChanged"
                    Visibility="Collapsed">
                    <controls:ChromaKeyToolbar.RenderTransform>
                        <TranslateTransform Y="-8" />
                    </controls:ChromaKeyToolbar.RenderTransform>
                </controls:ChromaKeyToolbar>

                <!--  Shapes options  -->
                <controls:ShapeToolbar
                    x:Name="ShapeToolbarHost"
                    HorizontalAlignment="Center"
                    FillColor="{x:Bind ViewModel.ShapeTool.ShapeFillColor, Mode=OneWay}"
                    FillColorChanged="ShapeToolbar_FillColorChanged"
                    FillColorOptions="{x:Bind ViewModel.ShapeTool.ShapeFillColorOptions, Mode=OneWay}"
                    FillOpacity="{x:Bind ViewModel.ShapeTool.ShapeFillOpacity, Mode=OneWay}"
                    FillOpacityChanged="ShapeToolbar_FillOpacityChanged"
                    Opacity="0"
                    SelectedShapeTypeIndex="{x:Bind ViewModel.ShapeTool.SelectedShapeType, Mode=OneWay, Converter={StaticResource ShapeTypeToIntConverter}}"
                    SelectedShapeTypeIndexChanged="ShapeToolbar_SelectedShapeTypeIndexChanged"
                    StrokeColor="{x:Bind ViewModel.ShapeTool.ShapeStrokeColor, Mode=OneWay}"
                    StrokeColorChanged="ShapeToolbar_StrokeColorChanged"
                    StrokeColorOptions="{x:Bind ViewModel.ShapeTool.ShapeStrokeColorOptions, Mode=OneWay}"
                    StrokeOpacity="{x:Bind ViewModel.ShapeTool.ShapeStrokeOpacity, Mode=OneWay}"
                    StrokeOpacityChanged="ShapeToolbar_StrokeOpacityChanged"
                    StrokeWidth="{x:Bind ViewModel.ShapeTool.ShapeStrokeWidth, Mode=OneWay}"
                    StrokeWidthChanged="ShapeToolbar_StrokeWidthChanged"
                    StyleInteractionCompleted="Toolbar_StyleInteractionCompleted"
                    StyleInteractionStarted="Toolbar_StyleInteractionStarted"
                    Visibility="Collapsed">
                    <controls:ShapeToolbar.RenderTransform>
                        <TranslateTransform Y="-8" />
                    </controls:ShapeToolbar.RenderTransform>
                </controls:ShapeToolbar>

                <!--  Text options  -->
                <controls:TextToolbar
                    x:Name="TextToolbarHost"
                    HorizontalAlignment="Center"
                    Opacity="0"
                    StyleInteractionCompleted="Toolbar_StyleInteractionCompleted"
                    StyleInteractionStarted="Toolbar_StyleInteractionStarted"
                    TextBackgroundColor="{x:Bind ViewModel.TextTool.TextBackgroundColor, Mode=OneWay}"
                    TextBackgroundColorChanged="TextToolbar_BackgroundColorChanged"
                    TextBackgroundColorOpacity="{x:Bind ViewModel.TextTool.TextBackgroundColorOpacity, Mode=OneWay}"
                    TextBackgroundColorOpacityChanged="TextToolbar_BackgroundColorOpacityChanged"
                    TextBackgroundColorOptions="{x:Bind ViewModel.TextTool.TextBackgroundColorOptions, Mode=OneWay}"
                    TextFontColor="{x:Bind ViewModel.TextTool.TextFontColor, Mode=OneWay}"
                    TextFontColorChanged="TextToolbar_FontColorChanged"
                    TextFontColorOpacity="{x:Bind ViewModel.TextTool.TextFontColorOpacity, Mode=OneWay}"
                    TextFontColorOpacityChanged="TextToolbar_FontColorOpacityChanged"
                    TextFontColorOptions="{x:Bind ViewModel.TextTool.TextFontColorOptions, Mode=OneWay}"
                    TextFontFamily="{x:Bind ViewModel.TextTool.TextFontFamily, Mode=OneWay}"
                    TextFontFamilyChanged="TextToolbar_FontFamilyChanged"
                    TextFontSize="{x:Bind ViewModel.TextTool.TextFontSize, Mode=OneWay}"
                    TextFontSizeChanged="TextToolbar_FontSizeChanged"
                    Visibility="Collapsed">
                    <controls:TextToolbar.RenderTransform>
                        <TranslateTransform Y="-8" />
                    </controls:TextToolbar.RenderTransform>
                </controls:TextToolbar>

                <!--  Color picker options  -->
                <controls:ColorPickerToolbar
                    x:Name="ColorPickerToolbarHost"
                    HorizontalAlignment="Center"
                    Opacity="0"
                    PickedColor="{x:Bind ViewModel.ColorPickerTool.PickedColor, Mode=OneWay}"
                    PickedColorValue="{x:Bind ViewModel.ColorPickerTool.PickedColorValue, Mode=OneWay}"
                    SelectedColorTypeIndex="{x:Bind ViewModel.ColorPickerTool.SelectedColorTypeIndex, Mode=OneWay}"
                    SelectedColorTypeIndexChanged="ColorPickerToolbar_SelectedColorTypeIndexChanged"
                    Visibility="Collapsed">
                    <controls:ColorPickerToolbar.RenderTransform>
                        <TranslateTransform Y="-8" />
                    </controls:ColorPickerToolbar.RenderTransform>
                </controls:ColorPickerToolbar>

                <!--  Text extraction options  -->
                <controls:TextExtractionToolbar
                    x:Name="TextExtractionToolbarHost"
                    HorizontalAlignment="Center"
                    CopyAllTextCommand="{x:Bind ViewModel.TextExtractionTool.CopyAllTextCommand, Mode=OneWay}"
                    Opacity="0"
                    Visibility="Collapsed">
                    <controls:TextExtractionToolbar.RenderTransform>
                        <TranslateTransform Y="-8" />
                    </controls:TextExtractionToolbar.RenderTransform>
                </controls:TextExtractionToolbar>

                <!--  Foreground extraction instructions  -->
                <controls:ForegroundExtractionToolbar
                    x:Name="ForegroundExtractionToolbarHost"
                    HorizontalAlignment="Center"
                    Opacity="0"
                    Visibility="Collapsed">
                    <controls:ForegroundExtractionToolbar.RenderTransform>
                        <TranslateTransform Y="-8" />
                    </controls:ForegroundExtractionToolbar.RenderTransform>
                </controls:ForegroundExtractionToolbar>

                <!--  Object erase instructions  -->
                <controls:ObjectEraseToolbar
                    x:Name="ObjectEraseToolbarHost"
                    HorizontalAlignment="Center"
                    Opacity="0"
                    Visibility="Collapsed">
                    <controls:ObjectEraseToolbar.RenderTransform>
                        <TranslateTransform Y="-8" />
                    </controls:ObjectEraseToolbar.RenderTransform>
                </controls:ObjectEraseToolbar>

                <!--  Object extraction instructions  -->
                <controls:ObjectExtractionToolbar
                    x:Name="ObjectExtractionToolbarHost"
                    HorizontalAlignment="Center"
                    Opacity="0"
                    Visibility="Collapsed">
                    <controls:ObjectExtractionToolbar.RenderTransform>
                        <TranslateTransform Y="-8" />
                    </controls:ObjectExtractionToolbar.RenderTransform>
                </controls:ObjectExtractionToolbar>

                <!--  Image description options and output  -->
                <StackPanel
                    x:Name="ImageDescriptionToolbarHost"
                    HorizontalAlignment="Center"
                    Opacity="0"
                    Spacing="8"
                    Visibility="Collapsed">
                    <StackPanel.RenderTransform>
                        <TranslateTransform Y="-8" />
                    </StackPanel.RenderTransform>
                    <controls:ImageDescriptionToolbar
                        AccessibleCommand="{x:Bind ViewModel.GenerateAccessibleImageDescriptionCommand, Mode=OneWay}"
                        BriefCommand="{x:Bind ViewModel.GenerateBriefImageDescriptionCommand, Mode=OneWay}"
                        DetailedCommand="{x:Bind ViewModel.GenerateDetailedImageDescriptionCommand, Mode=OneWay}"
                        DiagramCommand="{x:Bind ViewModel.GenerateDiagramImageDescriptionCommand, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        IsAccessibleSelected="{x:Bind ViewModel.IsAccessibleImageDescriptionSelected, Mode=OneWay}"
                        IsBriefSelected="{x:Bind ViewModel.IsBriefImageDescriptionSelected, Mode=OneWay}"
                        IsDetailedSelected="{x:Bind ViewModel.IsDetailedImageDescriptionSelected, Mode=OneWay}"
                        IsDiagramSelected="{x:Bind ViewModel.IsDiagramImageDescriptionSelected, Mode=OneWay}" />
                    <Border
                        x:Uid="ImageDescriptionPanel"
                        MaxWidth="640"
                        Padding="16,12"
                        AutomationProperties.LiveSetting="Polite"
                        Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Translation="0,0,16"
                        Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasImageDescription), Mode=OneWay}">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Uid="ImageDescriptionPanel_Title"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold" />
                                <Button
                                    x:Uid="ImageDescriptionPanel_CopyButton"
                                    Grid.Column="1"
                                    Padding="8,4"
                                    AutomationProperties.AutomationId="ImageEdit_ImageDescriptionCopyButton"
                                    Command="{x:Bind ViewModel.CopyImageDescriptionCommand, Mode=OneWay}"
                                    Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.HasImageDescription), Mode=OneWay}">
                                    <SymbolIcon Symbol="Copy" />
                                </Button>
                            </Grid>
                            <TextBlock
                                AutomationProperties.AutomationId="ImageEdit_ImageDescriptionOutput"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.ImageDescription, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <ProgressRing
            x:Uid="ImageEdit_TextExtractionProgressRing"
            Grid.Row="2"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="True"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <ProgressRing
            Grid.Row="2"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsSuperResolutionGenerating, Mode=OneWay}"
            Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsSuperResolutionGenerating), Mode=OneWay}" />

        <ProgressRing
            Grid.Row="2"
            AutomationProperties.AutomationId="ImageEdit_TextExtractionProgressRing"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsTextExtractionRunning, Mode=OneWay}"
            Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsTextExtractionRunning), Mode=OneWay}" />

        <ProgressRing
            x:Uid="ImageEdit_ImageDescriptionProgressRing"
            Grid.Row="2"
            AutomationProperties.AutomationId="ImageEdit_ImageDescriptionProgressRing"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsImageDescriptionRunning, Mode=OneWay}"
            Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsImageDescriptionRunning), Mode=OneWay}" />

        <ProgressRing
            x:Uid="ImageEdit_ForegroundExtractionProgressRing"
            Grid.Row="2"
            AutomationProperties.AutomationId="ImageEdit_ForegroundExtractionProgressRing"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsForegroundExtractionRunning, Mode=OneWay}"
            Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsForegroundExtractionRunning), Mode=OneWay}" />

        <ProgressRing
            x:Uid="ImageEdit_ObjectEraseProgressRing"
            Grid.Row="2"
            AutomationProperties.AutomationId="ImageEdit_ObjectEraseProgressRing"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsObjectEraseRunning, Mode=OneWay}"
            Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsObjectEraseRunning), Mode=OneWay}" />

        <ProgressRing
            x:Uid="ImageEdit_ObjectExtractionProgressRing"
            Grid.Row="2"
            AutomationProperties.AutomationId="ImageEdit_ObjectExtractionProgressRing"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsObjectExtractionRunning, Mode=OneWay}"
            Visibility="{x:Bind utils:VisibilityUtility.BoolToVisibility(ViewModel.IsObjectExtractionRunning), Mode=OneWay}" />

        <Grid
            MinHeight="38"
            Padding="8"
            Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="InfoPanel"
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <TextBlock
                    x:Name="DimensionsTextBlock"
                    x:Uid="ImageEdit_Info_Dimensions"
                    MinWidth="72"
                    FontSize="12"
                    FontWeight="SemiLight"
                    TextAlignment="Right">
                    <Run Text="{x:Bind ViewModel.CropRect.Width, Mode=OneWay}" />
                    <Run Text="×" />
                    <Run Text="{x:Bind ViewModel.CropRect.Height, Mode=OneWay}" /><Run Text="px" />
                </TextBlock>
                <TextBlock
                    x:Name="OffsetTextBlock"
                    x:Uid="ImageEdit_Info_Offset"
                    MinWidth="72"
                    FontSize="12"
                    FontWeight="SemiLight"
                    TextAlignment="Right">
                    <Run Text="(" /><Run Text="{x:Bind ViewModel.CropRect.Left, Mode=OneWay}" /><Run Text="," />
                    <Run Text="{x:Bind ViewModel.CropRect.Top, Mode=OneWay}" /><Run Text=")" /><Run Text="px" />
                </TextBlock>
                <TextBlock
                    x:Name="RotationTextBlock"
                    x:Uid="ImageEdit_Info_Rotation"
                    MinWidth="36"
                    FontSize="12"
                    FontWeight="SemiLight"
                    Text="{x:Bind ViewModel.RotationDisplayName, Mode=OneWay}"
                    TextAlignment="Right" />
                <TextBlock
                    x:Name="MirroredTextBlock"
                    x:Uid="ImageEdit_Info_Mirrored"
                    MinWidth="72"
                    FontSize="12"
                    FontWeight="SemiLight"
                    Text="{x:Bind ViewModel.MirroredDisplayName, Mode=OneWay}"
                    TextAlignment="Right" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ToggleButton
                    x:Name="AutoZoomLockToggle"
                    x:Uid="ImageEdit_AutoZoomLockButton"
                    MinWidth="32"
                    Padding="8,4"
                    Checked="AutoZoomLockToggle_IsCheckedChanged"
                    IsChecked="{x:Bind ViewModel.IsAutoZoomLocked, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}"
                    Unchecked="AutoZoomLockToggle_IsCheckedChanged">
                    <FontIcon FontSize="16" Glyph="&#xE72E;" />
                </ToggleButton>
                <Button
                    x:Uid="ImageEdit_ZoomAndCenterButton"
                    MinWidth="32"
                    Padding="8,4"
                    Command="{x:Bind ViewModel.ZoomAndCenterCommand}"
                    IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xE71E;" />
                </Button>
                <TextBlock
                    x:Uid="ImageEdit_ZoomLabel"
                    VerticalAlignment="Center"
                    FontSize="12" />
                <Slider
                    x:Name="ZoomSlider"
                    Width="120"
                    VerticalAlignment="Center"
                    IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}"
                    Maximum="200"
                    Minimum="1"
                    StepFrequency="1"
                    ValueChanged="ZoomSlider_ValueChanged"
                    Value="{x:Bind ViewModel.ZoomPercentage, Mode=OneWay}" />
                <TextBlock
                    MinWidth="32"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{x:Bind FormatZoomPercentage(ViewModel.ZoomPercentage), Mode=OneWay}"
                    TextAlignment="Right" />
            </StackPanel>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <!--  Minimal: Show only dimensions (smallest screens)  -->
                <VisualState x:Name="MinimalState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DimensionsTextBlock.Visibility" Value="Visible" />
                        <Setter Target="OffsetTextBlock.Visibility" Value="Collapsed" />
                        <Setter Target="RotationTextBlock.Visibility" Value="Collapsed" />
                        <Setter Target="MirroredTextBlock.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <!--  Narrow: Show Dimensions and Offset  -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="550" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DimensionsTextBlock.Visibility" Value="Visible" />
                        <Setter Target="OffsetTextBlock.Visibility" Value="Visible" />
                        <Setter Target="RotationTextBlock.Visibility" Value="Collapsed" />
                        <Setter Target="MirroredTextBlock.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <!--  Medium: Show Dimensions, Offset, and Rotation  -->
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DimensionsTextBlock.Visibility" Value="Visible" />
                        <Setter Target="OffsetTextBlock.Visibility" Value="Visible" />
                        <Setter Target="RotationTextBlock.Visibility" Value="Visible" />
                        <Setter Target="MirroredTextBlock.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <!--  Wide: Show all info  -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="650" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DimensionsTextBlock.Visibility" Value="Visible" />
                        <Setter Target="OffsetTextBlock.Visibility" Value="Visible" />
                        <Setter Target="RotationTextBlock.Visibility" Value="Visible" />
                        <Setter Target="MirroredTextBlock.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</local:ImageEditPageBase>
