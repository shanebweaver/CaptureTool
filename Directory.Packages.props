<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CaptureKitPackageVersion>1.0.6</CaptureKitPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="CaptureKit.Abstractions" Version="$(CaptureKitPackageVersion)" />
    <PackageVersion Include="CaptureKit.Windows" Version="$(CaptureKitPackageVersion)" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.AI.Foundry.Local.WinML" Version="1.2.4" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageVersion Include="Microsoft.Services.Store.SDK" Version="10.1705.16001" />
    <PackageVersion Include="Microsoft.Services.Store.Engagement" Version="10.2307.3001" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.298" />
    <PackageVersion Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.AI" Version="2.6.5" />
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <!-- Keep the drawing assemblies aligned with the net10.0 target framework. -->
    <PackageVersion Include="System.Drawing.Common" Version="11.0.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
    <!-- Test packages -->
    <PackageVersion Include="AutoFixture.AutoMoq" Version="4.18.1" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="Microsoft.CodeCoverage" Version="18.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.TestPlatform.TestHost" Version="17.13.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="MSTest.Analyzers" Version="4.1.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.2" />
  </ItemGroup>
</Project>
