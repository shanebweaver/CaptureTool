# .editorconfig

# Top-level settings that apply to all files
root = true

# Settings for C# files
[*.cs]

# IDE0290: Use primary constructor
# This line tells the C# code style engine not to prefer primary constructors.
csharp_style_prefer_primary_constructors = false

# This line explicitly sets the severity of the IDE0290 diagnostic to 'none',
# which effectively disables it and prevents it from showing as a suggestion,
# warning, or error.
dotnet_diagnostic.IDE0290.severity = none

# Keep pipeline control flow readable, especially ownership and cancellation paths.
[src/{CaptureTool.Application,CaptureTool.Application.Abstractions,CaptureTool.Infrastructure}/Analysis/**.cs]
csharp_prefer_braces = true:warning
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# Keep the capture analysis UI consistent with the pipeline's explicit control flow.
[src/CaptureTool.Presentation/Features/CaptureDetails/**.cs]
csharp_prefer_braces = true:warning
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

[src/CaptureTool.Presentation/Features/Settings/CaptureMemoryViewModel.cs]
csharp_prefer_braces = true:warning
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

[src/CaptureTool.Presentation.Windows.WinUI/Xaml/Controls/CaptureDetailsPane*.cs]
csharp_prefer_braces = true:warning
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

[src/CaptureTool.Infrastructure.Analysis.Windows/**.cs]
csharp_prefer_braces = true:warning
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true
