<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <LangVersion>14.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <CaptureKitSiblingPackageSource>$(MSBuildThisFileDirectory)..\CaptureKit\artifacts\packages</CaptureKitSiblingPackageSource>
    <CaptureKitWorkflowPackageSource>$(MSBuildThisFileDirectory)CaptureKit\artifacts\packages</CaptureKitWorkflowPackageSource>
    <RestoreAdditionalProjectSources Condition="Exists('$(CaptureKitSiblingPackageSource)')">$(RestoreAdditionalProjectSources);$(CaptureKitSiblingPackageSource)</RestoreAdditionalProjectSources>
    <RestoreAdditionalProjectSources Condition="Exists('$(CaptureKitWorkflowPackageSource)')">$(RestoreAdditionalProjectSources);$(CaptureKitWorkflowPackageSource)</RestoreAdditionalProjectSources>
  </PropertyGroup>
</Project>
